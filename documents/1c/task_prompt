Функция РаспределитьПоСкладам(Товары, ОстаткиПоСкладам) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Склад");
	Результат.Колонки.Добавить("Затребовано");
	Результат.Колонки.Добавить("КРезерву");
	
	Для Каждого СтрокаТовара Из Товары Цикл
		
		ОсталосьРаспределить = СтрокаТовара.Затребовано;
		
		Для Каждого СтрокаОстатка Из ОстаткиПоСкладам Цикл
			
			Если СтрокаОстатка.Номенклатура <> СтрокаТовара.Номенклатура Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаОстатка.Характеристика <> СтрокаТовара.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаОстатка.Склад) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаОстатка.Остаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ОсталосьРаспределить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоКРезерву = Мин(ОсталосьРаспределить, СтрокаОстатка.Остаток);
			
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
			НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
			НоваяСтрока.Склад = СтрокаОстатка.Склад;
			НоваяСтрока.Затребовано = СтрокаТовара.Затребовано;
			НоваяСтрока.КРезерву = КоличествоКРезерву;
			
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКРезерву;
			
		КонецЦикла;
		
		Если ОсталосьРаспределить > 0 Тогда 
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
			НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
			НоваяСтрока.Склад = Неопределено;
			НоваяСтрока.Затребовано = СтрокаТовара.Затребовано;
			НоваяСтрока.КРезерву = ОсталосьРаспределить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПостроитьПараметрыТоваров(МассивТоваров)
	ПараметрыТоваров = Новый Соответствие;
	
	Для Каждого ТоварJSON Из МассивТоваров Цикл
		УИДТовар = Новый УникальныйИдентификатор(ТоварJSON.Получить("product_ref"));
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИДТовар);
		
		Характеристика = Неопределено;
		Если ЗначениеЗаполнено(ТоварJSON.Получить("char_ref")) Тогда
			УИДХарактеристика = Новый УникальныйИдентификатор(ТоварJSON.Получить("char_ref"));
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(УИДХарактеристика);
		КонецЕсли;
		
		Цена = 0;
		Если ЗначениеЗаполнено(ТоварJSON.Получить("price")) Тогда
			Цена = ТоварJSON.Получить("price");
		ИначеЕсли ТоварJSON.Получить("quant") <> 0 Тогда
			Цена = ТоварJSON.Получить("total") / ТоварJSON.Получить("quant");
		КонецЕсли;
		
		Коэффициент = 1;
		Если ЗначениеЗаполнено(ТоварJSON.Получить("measure_unit_k")) Тогда
			Коэффициент = ТоварJSON.Получить("measure_unit_k");
		КонецЕсли;
		
		Параметры = Новый Структура;
		Параметры.Вставить("Цена", Цена);
		Параметры.Вставить("Коэффициент", Коэффициент);
		Параметры.Вставить("Количество", ТоварJSON.Получить("quant"));
		Параметры.Вставить("Сумма", ТоварJSON.Получить("total"));
		
		ПараметрыТоваров.Вставить(КлючТовара(Номенклатура, Характеристика), Параметры);
	КонецЦикла;
	
	Возврат ПараметрыТоваров;
КонецФункции

