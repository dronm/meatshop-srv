Функция ПолучитьНастройкиПеремещенияДляЗаказа(ЗаказОбъект)
	Результат = Новый Структура;
	
	Если ЗаказОбъект.Склад = СкладСсылкаПоГУИД(ГлГрИд) Тогда
		Результат.Вставить("СкладПолучатель", СкладСсылкаПоГУИД(Гл1Ид));
		Результат.Вставить("Подразделение", ПодразделениеСсылкаПоГУИД(ПодразделениеГлИд));
	ИначеЕсли ЗаказОбъект.Склад = СкладСсылкаПоГУИД(ФГрИд) Тогда
		Результат.Вставить("СкладПолучатель", СкладСсылкаПоГУИД(Ф1Ид));
		Результат.Вставить("Подразделение", ПодразделениеСсылкаПоГУИД(ПодразделениеФИд));
	Иначе
		ВызватьИсключение("Не удалось определить настройки перемещения для склада заказа: " + Строка(ЗаказОбъект.Склад));
	КонецЕсли;
	
	Возврат Результат;
