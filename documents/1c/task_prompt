Функция ExecuteCommand(Команда, Параметры) Экспорт
    рез = Новый Структура;
    рез.Вставить("success", True);
	рез.Вставить("error", "");
	
	Если Команда = "catalog_by_attr" Тогда
		CatalogByAttrMethod(Параметры, рез);
		
	ИначеЕсли Команда = "ping" Тогда
		PingMethod(Параметры, рез);

	ИначеЕсли Команда = "get_shipments" Тогда
		GetShipmentsMethod(Параметры, рез);

	ИначеЕсли Команда = "get_client" Тогда
		GetClientMethod(Параметры, рез);

	ИначеЕсли Команда = "complete_client_dog" Тогда
		CompleteClientDogMethod(Параметры, рез);

	ИначеЕсли Команда = "get_client_dog" Тогда
		GetClientDogMethod(Параметры, рез);
		
	ИначеЕсли Команда = "get_client_debt_list" Тогда	
		GetClientDebtListMethod(Параметры, рез); 
		
	ИначеЕсли Команда = "new_order" Тогда	
		NewOrderMethod(Параметры, рез); 
		
	ИначеЕсли Команда = "new_shipment" Тогда	
		NewShipmentMethod(Параметры, рез); 

	ИначеЕсли Команда = "new_production" Тогда	
		NewProductionMethod(Параметры, рез); 

	ИначеЕсли Команда = "new_production_mat" Тогда	
		NewProductionMatMethod(Параметры, рез); 
		
	ИначеЕсли Команда = "print_order" Тогда	
		PrintOrderMethod(Параметры, рез); 
		
	Иначе
		рез.success = False;
		рез.error = "command "+Команда+" not found";
	КонецЕсли;
	
	Возврат Serialize(рез);
КонецФункции	
