Функция ПолучитьОбъектРасчетовПоЗаказуБезИсключения(ЗаказСсылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбъектыРасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|ГДЕ
	|	ОбъектыРасчетов.Объект = &ЗаказСсылка
	|	И НЕ ОбъектыРасчетов.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьПеремещенияЗаказа(ЗаказСсылка)
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Перемещения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаПеремещение КАК Перемещения
	|ГДЕ
	|	Перемещения.ДокументОснование = &ЗаказСсылка
	|УПОРЯДОЧИТЬ ПО
	|	Перемещения.Дата,
	|	Перемещения.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Процедура ПодготовитьПеремещенияКПереиспользованию(ПеремещенияЗаказа)
	Для Каждого СсылкаПеремещения Из ПеремещенияЗаказа Цикл
		ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();		
		Если ПеремещениеОбъект.Проведен Тогда
			ПеремещениеОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;		
		ПеремещениеОбъект.Товары.Очистить();
		ПеремещениеОбъект.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьИлиСоздатьПеремещение(ПеремещенияЗаказа, НомерПеремещения, ЗаказСсылка)
	Если НомерПеремещения < ПеремещенияЗаказа.Количество() Тогда
		СсылкаПеремещения = ПеремещенияЗаказа[НомерПеремещения];
		СсылкаПеремещения.УстановитьПометкуУдаления(Ложь);
		ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();
	Иначе
		ПеремещениеОбъект = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		ПеремещениеОбъект.ДокументОснование = ЗаказСсылка;
	КонецЕсли;
	
	Возврат ПеремещениеОбъект;
КонецФункции

Процедура ПометитьЛишниеПеремещенияНаУдаление(ПеремещенияЗаказа, НачинаяСИндекса)
	Если НачинаяСИндекса >= ПеремещенияЗаказа.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Для ИндексПеремещения = НачинаяСИндекса По ПеремещенияЗаказа.Количество() - 1 Цикл
		СсылкаПеремещения = ПеремещенияЗаказа[ИндексПеремещения];
		ПеремещениеОбъект = СсылкаПеремещения.ПолучитьОбъект();
		
		Если ПеремещениеОбъект.Проведен Тогда
			ПеремещениеОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		
		Если ПеремещениеОбъект.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
			ПеремещениеОбъект.Товары.Очистить();
		КонецЕсли;
		
		ПеремещениеОбъект.Записать();
		СсылкаПеремещения.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОбъектРасчетовПоЗаказу(ЗаказСсылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);
