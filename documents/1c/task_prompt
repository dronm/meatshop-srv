	ИначеЕсли Команда = "sale_by_ref" Тогда
		CommandSaleByRef(Параметры, рез);
		
	ИначеЕсли Команда = "ping" Тогда
		
	ИначеЕсли Команда = "TestMethod" Тогда
		TestMethod(Параметры, рез);
		
	Иначе
		рез.success = False;
		рез.error = "command "+Команда+" not found";
	КонецЕсли;
	
	Возврат Serialize(рез);
