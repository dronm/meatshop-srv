			Номенклатура = Справочники.Номенклатура.НайтиПоКоду(code_1c);
			Если Номенклатура.Пустая() Тогда
				ВызватьИсключение("Не найдена номенклатура по коду:"+code_1c);
			КонецЕсли;	
			
			СтрокаДокумента = Реализ.Услуги.Добавить();
			СтрокаДокумента.Номенклатура = Номенклатура;
			
			СтрокаДокумента.Цена = Товар.Получить("price");
			СтрокаДокумента.Сумма = Товар.Получить("total");
			
			СтрокаДокумента.СтавкаНДС = СтавкаНДС(Реализ.Дата);
			ПроцентНДС = ПроцентНДСПоСтавке(СтрокаДокумента.СтавкаНДС);
			СтрокаДокумента.СуммаНДС = Окр(СтрокаДокумента.Сумма * ПроцентНДС / (100 + ПроцентНДС),2);
			
			СтрокаДокумента.Количество = Товар.Получить("quant"); 
			
			СтрокаДокумента.СчетДоходов = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД;
			СтрокаДокумента.Субконто = Справочники.НоменклатурныеГруппы.НайтиПоНаименованию("Услуги автотранспорта", Истина);
			СтрокаДокумента.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.Продажи_НДС;
			СтрокаДокумента.СчетРасходов = ПланыСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД;
			
			Всего = Всего + СтрокаДокумента.Сумма; 
		КонецЦикла;
	КонецЕсли;
	
	Реализ.Ответственный = Ответственный(params.Получить("user_ref"));
	Реализ.СуммаДокумента = Всего;
	Реализ.Записать(РежимЗаписиДокумента.Проведение);
	
	res.Вставить("payload", СсылкаНаДокумент1с(Реализ.Ссылка));
	
