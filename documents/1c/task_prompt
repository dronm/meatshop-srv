Процедура NewProductionMatMethod(paramsStr, res)
	params = ParseJSON(paramsStr);
	mat_refs = params.Получить("material_ref_1c");
	transf_refs = params.Получить("transfer_ref_1c");
	make_transfers = params.Получить("make_transfers");
	
	СписокДокументов = Новый Массив;
	Если ЗначениеЗаполнено(mat_refs) Тогда
		//Модификация
		Для Каждого ref Из mat_refs Цикл
			id =  Новый УникальныйИдентификатор(ref.Получить("id"));
			ТребНаклСсылка = Документы.ТребованиеНакладная.ПолучитьСсылку(id);
			Если НЕ ЗначениеЗаполнено(ТребНаклСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			ТребНакл = ТребНаклСсылка.ПолучитьОбъект();
			Если ТребНакл.Проведен Тогда
				ТребНакл.Проведен = Ложь;							
			КонецЕсли; 
			ТребНакл.Материалы.Очистить();
			ТребНакл.Записать(РежимЗаписиДокумента.Запись);
			СписокДокументов.Добавить(ТребНаклСсылка);
		КонецЦикла;	
	КонецЕсли;	                                                  
	
	Если make_transfers Тогда
		СписокДокументовПеремещ = Новый Массив;
		Если ЗначениеЗаполнено(transf_refs) Тогда
			//Модификация
			Для Каждого ref Из transf_refs Цикл
				id =  Новый УникальныйИдентификатор(ref.Получить("id"));
				ПеремещСсылка = Документы.ПеремещениеТоваров.ПолучитьСсылку(id);
				Если НЕ ЗначениеЗаполнено(ПеремещСсылка) Тогда
					Продолжить;
				КонецЕсли;
				
				Перемещ = ПеремещСсылка.ПолучитьОбъект();
				Если Перемещ.Проведен Тогда
					Перемещ.Проведен = Ложь;							
				КонецЕсли; 
				Перемещ.Материалы.Очистить();
				Перемещ.Товары.Очистить();
				Перемещ.Записать(РежимЗаписиДокумента.Запись);
				СписокДокументовПеремещ.Добавить(ПеремещСсылка);
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
	
	date = params.Получить("date") + "T09:50:00";
	ДатаДока = Дата1сИзISO(date);
	Отв = Ответственный(params.Получить("user_ref"));
	
	СписокДокументовВозвр = Новый Массив;
	СписокДокументовПеремещВозвр = Новый Массив;
	
	warehouses = params.Получить("warehouses");
	Для Каждого СкладСтр Из warehouses Цикл
		id =  Новый УникальныйИдентификатор(СкладСтр.Получить("ref_1c"));
		СкладСсылка = Справочники.Склады.ПолучитьСсылку(id);
		Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
			ВызватьИсключение("Не задан СкладСсылка");
		КонецЕсли;	
		
		Если СписокДокументов.Количество() > 0 Тогда
			ТребНаклСсылка = СписокДокументов[0];
			ТребНакл = ТребНаклСсылка.ПолучитьОбъект();
			СписокДокументов.Удалить(0);
		Иначе
			ТребНакл = Документы.ТребованиеНакладная.СоздатьДокумент();	
		КонецЕсли;	
		
		ТребНакл.Дата = ДатаДока; 
		ТребНакл.Организация = НашаОрганизация();
		ТребНакл.Склад = СкладСсылка;
		ТребНакл.СчетаУчетаЗатратВТаблице = Ложь;		
		ТребНакл.СчетЗатрат = ПланыСчетов.Хозрасчетный.ОсновноеПроизводство;		
		ТребНакл.Субконто1 = Справочники.НоменклатурныеГруппы.НайтиПоНаименованию("Продукция БСУ", Истина);
		ТребНакл.Субконто2 = Справочники.СтатьиЗатрат.НайтиПоНаименованию("Производственные 20", Истина);
		ТребНакл.НДСвСтоимостиТоваров = Перечисления.ДействиеНДСВСтоимостиТоваров.НеИзменять;
		ТребНакл.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
		ТребНакл.ВидОперации = Перечисления.ВидыОперацийРасходМатериалов.ИспользованиеМатериалов; 
		ТребНакл.СпособУчетаМатериаловПоСотруднику = Перечисления.СпособыУчетаМатериаловПоСотрудникам.Расход;
		ТребНакл.ТоварыПередаютсяВСоставеРабот = Ложь;
		
		//Перемещаем песок, щебень
		Перемещ = Неопределено;
		
		//Материалы
		materials = СкладСтр.Получить("materials");
		Для Каждого МатериалСтр Из materials Цикл   
			mat_ref_1c = МатериалСтр.Получить("ref_1c");
			Если НЕ ЗначениеЗаполнено(mat_ref_1c) Тогда
				Продолжить;
			КонецЕсли;	
			mat_id =  Новый УникальныйИдентификатор(mat_ref_1c);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(mat_id);
			
			Если
				(make_transfers) И
				(СтрНайти(Нрег(СкладСсылка.Наименование),"респуб") = 0) И 
				( (СтрНайти(Нрег(Номенклатура.Наименование), "песок") > 0)
				ИЛИ (СтрНайти(Нрег(Номенклатура.Наименование), "щеб") > 0) )
			Тогда
				Если Перемещ = Неопределено Тогда
					//Шапка
					Если СписокДокументовПеремещ.Количество() > 0 Тогда
						ПеремещСсылка = СписокДокументовПеремещ[0];
						Перемещ = ПеремещСсылка.ПолучитьОбъект();
						СписокДокументовПеремещ.Удалить(0);
					Иначе
						Перемещ = Документы.ПеремещениеТоваров.СоздатьДокумент();	
					КонецЕсли;
					date = params.Получить("date") + "T09:10:00";
					ДатаДокаПеремещ = Дата1сИзISO(date);
					
					Перемещ.Дата = ДатаДокаПеремещ; 
					Перемещ.Организация = НашаОрганизация();
					Перемещ.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ПередачаМеждуСкладами;
					Перемещ.СкладОтправитель = СкладМатериалов();
					Перемещ.СкладПолучатель = СкладСсылка;
					Перемещ.Ответственный = Отв;
					Перемещ.Комментарий = params.Получить("comment");
				КонецЕсли; 
				
				СтрокаДокумента = Перемещ.Товары.Добавить();
				СтрокаДокумента.Номенклатура = Номенклатура;
				СтрокаДокумента.Количество = МатериалСтр.Получить("quant"); 
				СтрокаДокумента.Коэффициент = 1;
				СтрокаДокумента.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(168);
				СтрокаДокумента.СчетУчета = ПланыСчетов.Хозрасчетный.СырьеИМатериалы;			
				СтрокаДокумента.НовыйСчетУчета = ПланыСчетов.Хозрасчетный.СырьеИМатериалы;
				СтрокаДокумента.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
			КонецЕсли;	
			
			СтрокаДокумента = ТребНакл.Материалы.Добавить();
			СтрокаДокумента.Номенклатура = Номенклатура;
			СтрокаДокумента.Количество = МатериалСтр.Получить("quant"); 
			СтрокаДокумента.Коэффициент = 1;
			СтрокаДокумента.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(168);
			СтрокаДокумента.Счет = ПланыСчетов.Хозрасчетный.СырьеИМатериалы;			
		КонецЦикла;
		
		ТребНакл.Комментарий = params.Получить("comment");
		ТребНакл.Ответственный = Отв;
		ТребНакл.Записать(РежимЗаписиДокумента.Проведение); 
		СписокДокументовВозвр.Добавить(СсылкаНаДокумент1с(ТребНакл.Ссылка));
		
		Если НЕ Перемещ = Неопределено Тогда
			Перемещ.Записать(РежимЗаписиДокумента.Проведение);
			СписокДокументовПеремещВозвр.Добавить(СсылкаНаДокумент1с(Перемещ.Ссылка));
		КонецЕсли;	
	КонецЦикла;

	Если make_transfers Тогда
		доки = Новый Структура;
		доки.Вставить("material_ref_1c", СписокДокументовВозвр);
		доки.Вставить("transfer_ref_1c", СписокДокументовПеремещВозвр);
		res.Вставить("payload", доки);		
	Иначе
		res.Вставить("payload", СписокДокументовВозвр);
	КонецЕсли;	
КонецПроцедуры	

