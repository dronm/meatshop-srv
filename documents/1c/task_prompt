				ВызватьИсключение("Не найдена номенклатура по коду:"+code_1c);
			КонецЕсли;	
			
			СтрокаДокумента = Реализ.Товары.Добавить();
			СтрокаДокумента.Номенклатура = Номенклатура;
			
