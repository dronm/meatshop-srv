Функция ПолучитьЗакрытыеЗаказыПоEcommerceIds(ECommerceIds) Экспорт

	ЗакрытыеЗаказы = Новый Массив;

	Для Каждого ЗначениеEcommerceID Из ECommerceIds Цикл

		Попытка

			ЗаказСсылка = НайтиЗаказПоИд(ЗначениеEcommerceID);
			Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или ЗаказСсылка.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			РеализацияСсылка = НайтиЗакрытуюРеализациюПоЗаказуКлиента(ЗаказСсылка);

			Если НЕ ЗначениеЗаполнено(РеализацияСсылка) Или РеализацияСсылка.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			ДанныеРеализации = ДанныеРеализацииТоваровУслуг(
				РеализацияСсылка,
				ЗначениеEcommerceID
			);

			ЗакрытыеЗаказы.Добавить(ДанныеРеализации);

		Исключение

			ЗаписьЖурналаРегистрации(
				"ECommerce",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ПолучитьЗакрытыеЗаказыПоEcommerceIds EcommerceID:"
				+ ЗначениеEcommerceID
				+ " "
				+ ОписаниеОшибки()
			);

		КонецПопытки;

	КонецЦикла;

	Возврат ЗакрытыеЗаказы;

КонецФункции

