	Реализ.Склад = СкладПродукции();
	Реализ.БанковскийСчетОрганизации = НашРС(Реализ.Организация);
	
	client_ref = params.Получить("client_ref");
	client_id =  Новый УникальныйИдентификатор(client_ref);
	Реализ.Контрагент = Справочники.Контрагенты.ПолучитьСсылку(client_id);
	Если Реализ.Контрагент.Пустая() Тогда
		ВызватьИсключение("Не найден контрагент по ссылке");
	КонецЕсли;	

	dog_ref = params.Получить("dogovor_ref");
	dog_id =  Новый УникальныйИдентификатор(dog_ref);
	Реализ.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(dog_id);
	Если Реализ.ДоговорКонтрагента.Пустая() Тогда
		ВызватьИсключение("Не найден договор по ссылке");
	КонецЕсли;	
	
	Реализ.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
	Реализ.ВалютаДокумента = ВалютаРуб();
