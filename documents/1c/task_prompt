//Возвращает имя файла с печатной формой
Процедура CommandPrintOrder(paramsStr, res)
	params = ParseJSON(paramsStr); 
	
	УИДРеализ = Новый УникальныйИдентификатор(params.Получить("order_ref"));
	Докум	= Документы.ЗаказКлиента.ПолучитьСсылку(УИДРеализ);
