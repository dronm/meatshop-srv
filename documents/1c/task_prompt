		//	Выборка.РазрешительныйРежимДатаЗапросаГИСМТ
		//);

		//ДанныеКодаМаркировки.Вставить(
		//	"permit_mode_software_instance_id",
		//	Выборка.РазрешительныйРежимИдентификаторЭкземпляраПО
		//);

		//ДанныеКодаМаркировки.Вставить(
		//	"permit_mode_base_version",
		//	Выборка.РазрешительныйРежимВерсияБазы
		//);

		//ДанныеКодаМаркировки.Вставить(
		//	"permit_mode_min_retail_price",
		//	Выборка.РазрешительныйРежимМинимальнаяРозничнаяЦена
		//);

		Коды.Добавить(ДанныеКодаМаркировки);

	КонецЦикла;

	Возврат Результат;

