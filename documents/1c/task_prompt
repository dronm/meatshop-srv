Функция ПостроитьТаблицуПеремещенийИзЗаказа(ЗаказОбъект)
	Перемещения = Новый ТаблицаЗначений;
	Перемещения.Колонки.Добавить("Отправитель", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Перемещения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Перемещения.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Перемещения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	
	Для Каждого СтрокаЗаказа Из ЗаказОбъект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Склад) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаЗаказа.Склад.Родитель <> ЗаказОбъект.Склад Тогда
			СтрПерем = Перемещения.Добавить();
			СтрПерем.Отправитель = СтрокаЗаказа.Склад;
			СтрПерем.Номенклатура = СтрокаЗаказа.Номенклатура;
			Если ЗначениеЗаполнено(СтрокаЗаказа.Характеристика) Тогда
				СтрПерем.Характеристика = СтрокаЗаказа.Характеристика;
			КонецЕсли;
			СтрПерем.Количество = СтрокаЗаказа.КоличествоУпаковок;
		КонецЕсли;
	КонецЦикла;
	
	Если Перемещения.Количество() > 0 Тогда
		Перемещения.Свернуть("Отправитель,Номенклатура,Характеристика", "Количество");
	КонецЕсли;
	
	Возврат Перемещения;
КонецФункции

