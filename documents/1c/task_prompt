Функция ДанныеСтрокиРеализации(Выборка, Количество, Сумма, КодМаркировки) Экспорт

	Товар = Новый Структура;

	Наименование = СокрЛП(Выборка.Наименование);

	Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
		Наименование = Наименование + ", " + СокрЛП(Выборка.Характеристика.Наименование);
	КонецЕсли;

	Товар.Вставить("name", Наименование);
	Товар.Вставить("quant", Количество);
	Товар.Вставить("product_ref", СокрЛП(Выборка.Номенклатура.УникальныйИдентификатор()));

	Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
		Товар.Вставить("char_ref", Выборка.Характеристика.УникальныйИдентификатор());
	КонецЕсли;

	Товар.Вставить("price", Выборка.Цена);
	Товар.Вставить("total", Сумма);
	Если ЗначениеЗаполнено(КодМаркировки) Тогда
		Товар.Вставить("marking_code", КодМаркировки);
	КонецЕсли;	

	Возврат Товар;

КонецФункции

Функция ДанныеРеализацииТоваровУслуг(Ссылка, EcommerceID) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("sale_ref", СсылкаНаДокумент1с(Ссылка));

	Если ПустаяСтрока(Строка(EcommerceID)) Тогда
		Результат.Вставить("ecommerce_id", 0);
	Иначе
		Результат.Вставить("ecommerce_id", Число(EcommerceID));
	КонецЕсли;

	Результат.Вставить("products", Новый Массив);

	КодыМаркировкиПоКлючу = ПолучитьКодыМаркировкиРеализацииПоКлючуНоменклатуры(Ссылка);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Номенклатура.Наименование КАК Наименование,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Ключ = КлючНоменклатурыХарактеристики(
			Выборка.Номенклатура,
			Выборка.Характеристика
		);

		КодыСтроки = КодыМаркировкиПоКлючу.Получить(Ключ);

		Если КодыСтроки <> Неопределено И КодыСтроки.Количество() > 0 Тогда

			Для Каждого ДанныеКодаМаркировки Из КодыСтроки Цикл

				Товар = ДанныеСтрокиРеализации(
					Выборка,
					1,
					Выборка.Цена,
					ДанныеКодаМаркировки.marking_code
				);

				Результат.products.Добавить(Товар);

			КонецЦикла;

		Иначе

			Товар = ДанныеСтрокиРеализации(
				Выборка,
				Выборка.Количество,
				Выборка.Сумма,
				""
			);

			Результат.products.Добавить(Товар);

		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

//*********************************************************************************
// params:
//	ecommerce_id
//
// Создает перемещения по уже существующему ЗаказКлиента.
// Идемпотентно переиспользует существующие документы перемещения,
// создает недостающие и помечает лишние на удаление.
// Создает эквайринговую операцию, также идемпотентно.
Процедура CommandOrderCommit(paramsStr, res)
	params = ParseJSON(paramsStr);
	
	Результат = Новый Структура;
	ПеремещенияДляСайта = Новый Массив;
	
	EcommerceID = params.Получить("ecommerce_id");
	
	НачатьТранзакцию();
	Попытка
		ДокумСсылка = НайтиЗаказПоИд(EcommerceID);
		Если ДокумСсылка = Неопределено Тогда
			ВызватьИсключение("Документ не найден");
		КонецЕсли;
		
		Докум = ДокумСсылка.ПолучитьОбъект();
		ПеремещенияЗаказа = ПолучитьПеремещенияЗаказа(Докум.Ссылка);
		ПодготовитьПеремещенияКПереиспользованию(ПеремещенияЗаказа);
		
		НастройкиПеремещения = ПолучитьНастройкиПеремещенияДляЗаказа(Докум);
		ПеремещСкладПолучатель = НастройкиПеремещения.СкладПолучатель;
		ПеремещПодразделение = НастройкиПеремещения.Подразделение;
		
		Перемещения = ПостроитьТаблицуПеремещенийИзЗаказа(Докум);
		
		ТОтправителей = Перемещения.Скопировать(, "Отправитель");
		Если ТОтправителей.Количество() > 0 Тогда
			ТОтправителей.Свернуть("Отправитель");
		КонецЕсли;
		
		НомерПеремещения = 0;
		Для Каждого СтрОтправитель Из ТОтправителей Цикл
			ПеремещДокум = ПолучитьИлиСоздатьПеремещение(ПеремещенияЗаказа, НомерПеремещения, Докум.Ссылка);
			НомерПеремещения = НомерПеремещения + 1;
			
			Если ПеремещДокум.Проведен Тогда
				ПеремещДокум.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			ПеремещДокум.Дата = Докум.Дата;
			ПеремещДокум.Комментарий = "ecommerce";
			ПеремещДокум.Организация = Докум.Организация;
			ПеремещДокум.ОрганизацияПолучатель = Докум.Организация;
			ПеремещДокум.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			ПеремещДокум.СкладОтправитель = СтрОтправитель.Отправитель;
			ПеремещДокум.СкладПолучатель = ПеремещСкладПолучатель;
			ПеремещДокум.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
			ПеремещДокум.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
			ПеремещДокум.ДокументОснование = Докум.Ссылка;
			ПеремещДокум.Подразделение = ПеремещПодразделение;
			ПеремещДокум.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			ПеремещДокум.Автор = ПараметрыСеанса.ТекущийПользователь;
			ПеремещДокум.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний", Истина);
			
			ПеремещениеДляСайта = Новый Структура;
			ПеремещениеДляСайтаТовары = Новый Массив;
			
			ПеремещДокум.Товары.Очистить();
			
			Для Каждого СтрПерем Из Перемещения Цикл
				Если СтрПерем.Отправитель = СтрОтправитель.Отправитель Тогда
					ПеремещДокумСтр = ПеремещДокум.Товары.Добавить();
					ПеремещДокумСтр.КоличествоУпаковок = СтрПерем.Количество;
					ПеремещДокумСтр.Номенклатура = СтрПерем.Номенклатура;
					ПеремещДокумСтр.Характеристика = СтрПерем.Характеристика;
					ПеремещДокумСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					
					ТоварДляСайта = Новый Структура;
					ТоварДляСайта.Вставить("product_ref", Строка(ПеремещДокумСтр.Номенклатура.УникальныйИдентификатор()));
					Если ЗначениеЗаполнено(ПеремещДокумСтр.Характеристика) Тогда
						ТоварДляСайта.Вставить("char_ref", Строка(ПеремещДокумСтр.Характеристика.УникальныйИдентификатор()));
					КонецЕсли;
					ТоварДляСайта.Вставить("quant", СтрПерем.Количество);
					ПеремещениеДляСайтаТовары.Добавить(ТоварДляСайта);
				КонецЕсли;
			КонецЦикла;
			
			ПеремещДокум.Записать(РежимЗаписиДокумента.Проведение);
			
			ПеремещениеДляСайта.Вставить("ref", СсылкаНаДокумент1с(ПеремещДокум.Ссылка));
			ПеремещениеДляСайта.Вставить("warehouse_sender_ref", Строка(ПеремещДокум.СкладОтправитель.УникальныйИдентификатор()));
			ПеремещениеДляСайта.Вставить("warehouse_recipient_ref", Строка(ПеремещДокум.СкладПолучатель.УникальныйИдентификатор()));
			ПеремещениеДляСайта.Вставить("products", ПеремещениеДляСайтаТовары);
			ПеремещенияДляСайта.Добавить(ПеремещениеДляСайта);
		КонецЦикла;
		
		ПометитьЛишниеПеремещенияНаУдаление(ПеремещенияЗаказа, НомерПеремещения);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Результат.Вставить("order_ref", СсылкаНаДокумент1с(Докум.Ссылка));
	Результат.Вставить("transfers", ПеремещенияДляСайта);
	res.Вставить("payload", Результат);
КонецПроцедуры

