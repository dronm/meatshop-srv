Процедура CommandNewClient(paramsStr, res) Экспорт

	params = ParseJSON(paramsStr);

	Наименование = ПолучитьСтрокуJSON(params, "name");
	НаименованиеПолное = ПолучитьСтрокуJSON(params, "name_full");
	ИНН = ПолучитьСтрокуJSON(params, "inn");
	КПП = ПолучитьСтрокуJSON(params, "kpp");
	ОГРН = ПолучитьСтрокуJSON(params, "ogrn");
	ОКПО = ПолучитьСтрокуJSON(params, "okpo");
	ОКВЭД = ПолучитьСтрокуJSON(params, "okved");

	АдресЮридический = ПолучитьСтрокуJSON(params, "address_legal");
	АдресФактический = ПолучитьСтрокуJSON(params, "address_fact");
	Телефоны = ПолучитьСтрокуJSON(params, "tels");
	ЭлектронныеПочты = ПолучитьСтрокуJSON(params, "emails");
	Руководитель = ПолучитьСтрокуJSON(params, "boss_name");
	ДолжностьРуководителя = ПолучитьСтрокуJSON(params, "boss_post");

	Если ИНН = "" Тогда
		ВызватьИсключение "Field inn is required";
	КонецЕсли;

	Если ОГРН = "" Тогда
		ВызватьИсключение "Field ogrn is required";
	КонецЕсли;

	Если Наименование = "" Тогда
		Наименование = НаименованиеПолное;
	КонецЕсли;

	Если Наименование = "" Тогда
		Наименование = ИНН;
	КонецЕсли;

	Если НаименованиеПолное = "" Тогда
		НаименованиеПолное = Наименование;
	КонецЕсли;

	КонтрагентСсылка = НайтиКонтрагентаПоИННКПП(ИНН, КПП);
	Создан = Ложь;

	Если Не ЗначениеЗаполнено(КонтрагентСсылка) Тогда

		ТранзакцияНачата = Ложь;

		Попытка

			НачатьТранзакцию();
			ТранзакцияНачата = Истина;

			ЭтоЮрЛицо = КПП <> "" Или СтрДлина(ОГРН) = 13;

			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();

			Контрагент.Наименование = Наименование;
			Контрагент.НаименованиеПолное = НаименованиеПолное;
			Контрагент.ИНН = ИНН;
			Контрагент.КПП = КПП;
			Контрагент.КодПоОКПО = ОКПО;
			Контрагент.РегистрационныйНомер = ОГРН;

			Попытка
				Контрагент.ОКВЭД = ОКВЭД;
			Исключение
			КонецПопытки;

			Если ЭтоЮрЛицо Тогда
				Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
				Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			Иначе
				Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
				Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
			КонецЕсли;

			Если Контрагент.Метаданные().Реквизиты.Найти("Партнер") <> Неопределено Тогда
				ПартнерСсылка = СоздатьПартнераДляКонтрагента(Наименование, НаименованиеПолное, ЭтоЮрЛицо);
				Если ПартнерСсылка <> Неопределено Тогда
					Контрагент.Партнер = ПартнерСсылка;
				КонецЕсли;
			КонецЕсли;

			ЗаполнитьДополнительныеРеквизитыКонтрагента(
				Контрагент,
				АдресЮридический,
				АдресФактический,
				Телефоны,
				ЭлектронныеПочты,
				Руководитель,
				ДолжностьРуководителя
			);

			Контрагент.Записать();

			КонтрагентСсылка = Контрагент.Ссылка;
			Создан = Истина;

			ЗафиксироватьТранзакцию();

		Исключение

			Если ТранзакцияНачата Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

			ВызватьИсключение;

		КонецПопытки;

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ref", СокрЛП(Строка(КонтрагентСсылка.УникальныйИдентификатор())));
	Результат.Вставить("created", Создан);

	res.Вставить("payload", Результат);

КонецПроцедуры

Функция НайтиКонтрагентаПоИННКПП(ИНН, КПП) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП";

	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

Функция СоздатьПартнераДляКонтрагента(Наименование, НаименованиеПолное, ЭтоЮрЛицо) Экспорт

	Если Метаданные.Справочники.Найти("Партнеры") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Партнер = Справочники.Партнеры.СоздатьЭлемент();

	Партнер.Наименование = Наименование;

	Попытка
		Партнер.НаименованиеПолное = НаименованиеПолное;
	Исключение
	КонецПопытки;

	Попытка
		Партнер.Клиент = Истина;
	Исключение
	КонецПопытки;

	Попытка
		Если ЭтоЮрЛицо Тогда
			Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
		Иначе
			Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Партнер.Записать();

	Возврат Партнер.Ссылка;

