Функция ПолучитьОстаткиПоСкладамТаблица(Товары,Магазин)
	Если Магазин = 1 Тогда
		ПриоритетныйСклад1 = СкладСсылкаПоГУИД(Гл1ИД);
		ПриоритетныйСклад2 = СкладСсылкаПоГУИД(Гл2Ид);
		ПриоритетныйСклад3 = СкладСсылкаПоГУИД(Ф1Ид);
		ПриоритетныйСклад4 = СкладСсылкаПоГУИД(Ф2Ид);
	Иначе
		ПриоритетныйСклад3 = СкладСсылкаПоГУИД(Гл1Ид);
		ПриоритетныйСклад4 = СкладСсылкаПоГУИД(Гл2Ид);
		ПриоритетныйСклад1 = СкладСсылкаПоГУИД(Ф1Ид);
		ПриоритетныйСклад2 = СкладСсылкаПоГУИД(Ф2Ид);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПриоритетныйСклад1) Тогда
		ВызватьИсключение "Не заполнен ПриоритетныйСклад1";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПриоритетныйСклад2) Тогда
		ВызватьИсключение "Не заполнен ПриоритетныйСклад2";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПриоритетныйСклад3) Тогда
		ВызватьИсключение "Не заполнен ПриоритетныйСклад3";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПриоритетныйСклад4) Тогда
		ВызватьИсключение "Не заполнен ПриоритетныйСклад4";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("ПриоритетныйСклад1", ПриоритетныйСклад1);
	Запрос.УстановитьПараметр("ПриоритетныйСклад2", ПриоритетныйСклад2);
	Запрос.УстановитьПараметр("ПриоритетныйСклад3", ПриоритетныйСклад3);
	Запрос.УстановитьПараметр("ПриоритетныйСклад4", ПриоритетныйСклад4);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Затребовано КАК Затребовано
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Характеристика КАК Характеристика,
	|	ВТ_Товары.Затребовано КАК Затребовано,
	|	Остатки.Склад КАК Склад,
	|	ЕСТЬNULL(Остатки.ВНаличииОстаток, 0)
	|		- ЕСТЬNULL(Остатки.РезервироватьНаСкладеОстаток, 0) КАК Остаток,
	|	ВЫБОР
	|		КОГДА Остатки.Склад = &ПриоритетныйСклад1 ТОГДА 1
	|		КОГДА Остатки.Склад = &ПриоритетныйСклад2 ТОГДА 2
	|		КОГДА Остатки.Склад = &ПриоритетныйСклад3 ТОГДА 3
	|		КОГДА Остатки.Склад = &ПриоритетныйСклад4 ТОГДА 4
	|		КОГДА Остатки.Склад ЕСТЬ NULL ТОГДА 999
	|		ИНАЧЕ 100
	|	КОНЕЦ КАК ПриоритетСклада
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки(
	|			,
	|			(Номенклатура, Характеристика) В
	|				(ВЫБРАТЬ
	|					ВТ_Товары.Номенклатура,
	|					ВТ_Товары.Характеристика
	|				ИЗ
	|					ВТ_Товары КАК ВТ_Товары)
	|		) КАК Остатки
	|		ПО ВТ_Товары.Номенклатура = Остатки.Номенклатура
	|			И ВТ_Товары.Характеристика = Остатки.Характеристика
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	ПриоритетСклада,
	|	Склад";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
