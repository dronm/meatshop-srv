Функция НайтиЗакрытуюРеализациюПоЗаказуКлиента(ЗаказСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.ЗаказКлиента = &ЗаказСсылка
	|	И Товары.Ссылка.Проведен
	|	И НЕ Товары.Ссылка.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Ссылка.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
