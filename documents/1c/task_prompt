	Докум.Валюта = Валюта;
	Докум.ЦенаВключаетНДС = Истина;
	Докум.НеОтгружатьЧастями = Ложь;
	Докум.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	Докум.ДатаСогласования = Докум.Дата;
	Докум.Согласован = Истина;
	Докум.СкидкиРассчитаны = Истина;
	Докум.БанковскийСчетКонтрагента = РасчетныйСчетКонтрагента(Докум.Контрагент);
	Докум.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Высокий", Истина);
	
	Доставка = params.Получить("delivery");
	Если ЗначениеЗаполнено(Доставка) Тогда
		//Докум.АдресДоставки = Доставка.Получить("address");
		//Докум.ВремяДоставкиС = Доставка.Получить("time_from");
		//Докум.ВремяДоставкиПо = Доставка.Получить("time_to");
		
		СпособДоставки = Доставка.Получить("type");
		Если СпособДоставки = "pickup" Тогда
			Докум.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		ИначеЕсли СпособДоставки = "to_client" Тогда
			Докум.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
		ИначеЕсли СпособДоставки = "to_client_by_courier" Тогда
			Докум.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
		ИначеЕсли СпособДоставки = "to_client_by_carrier" Тогда
			Докум.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика;
		КонецЕсли;
	КонецЕсли;

	Докум.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	Докум.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Докум.Автор = ПараметрыСеанса.ТекущийПользователь;
