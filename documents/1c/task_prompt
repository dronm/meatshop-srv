// params:
//	store_id
//	firm_ref
//	firm_bank_ref
//	client_ref
//	contract_ref
//	agreement_ref
//	delivery
//	date
//	products [quant, product_ref, char_ref, price, total, measure_unit_k]
//	ecommerce_id
//	require_pay
//	confirm_code
//	customer {name, email, phone }
//
// Делает только резервирование в ЗаказКлиента.
// Перемещения здесь не создаются и не возвращаются.
Процедура CommandOrderReserve(paramsStr, res)
	params = ParseJSON(paramsStr);
	
	Результат = Новый Структура;
	EcommerceID = params.Получить("ecommerce_id");
	
	НачатьТранзакцию();
	Попытка
		ДокумСсылка = НайтиЗаказПоИд(EcommerceID);
		Если ДокумСсылка = Неопределено Тогда
			Докум = Документы.ЗаказКлиента.СоздатьДокумент();
			Докум.ECommerceId = EcommerceID;
			
		Иначе
			Докум = ДокумСсылка.ПолучитьОбъект();
			Если Докум.ПометкаУдаления Тогда
				Докум.УстановитьПометкуУдаления(Ложь);	
			ИначеЕсли Докум.Проведен Тогда
				Докум.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли; 
			Докум.Товары.Очистить();
			Докум.ЭтапыГрафикаОплаты.Очистить();
			Докум.СкидкиНаценки.Очистить();
			Докум.НачислениеБонусныхБаллов.Очистить();
			Докум.ДополнительныеРеквизиты.Очистить();
		КонецЕсли;
		
		Докум.ConfirmCode = params.Получить("confirm_code");
		
		ЗаполнитьШапкуЗаказаИзПараметров(Докум, params);
		
		МассивТоваров = params.Получить("products");
		ПараметрыТоваров = ПостроитьПараметрыТоваров(МассивТоваров);
		Товары = ПостроитьТаблицуТребуемыхТоваров(МассивТоваров);
		
		Всего = 0;
		ОстаткиПоСкладам = ПолучитьОстаткиПоСкладамТаблица(Товары, params.Получить("store_id"));
		Распределено = РаспределитьПоСкладам(Товары, ОстаткиПоСкладам);
		
		НужноПеремещение = Ложь;
		ОшибкаОстатка = "";
		ОшибкаОстаткаКол = 0;
		
		Для Каждого Стр Из Распределено Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Склад) Тогда				
				Тов = СокрЛП(Стр.Номенклатура);
				Если ЗначениеЗаполнено(Стр.Характеристика) Тогда
					Тов = Тов + ","+ СокрЛП(Стр.Характеристика);
				КонецЕсли;
				ОшибкаОстатка = ОшибкаОстатка + ?(ОшибкаОстатка="", "", " ");
				ОшибкаОстатка = ОшибкаОстатка + Тов; 
				ОшибкаОстаткаКол = ОшибкаОстаткаКол + 1;
				Продолжить;
			КонецЕсли;
			
			Ключ = КлючТовара(Стр.Номенклатура, Стр.Характеристика); 
			ПарамТовара = ПараметрыТоваров.Получить(Ключ);
			Если ПарамТовара = Неопределено Тогда
				ВызватьИсключение("Не найдены параметры товара для строки заказа: " + Строка(Стр.Номенклатура));
			КонецЕсли;			
			
			Цена = ПарамТовара.Цена;
			Коэффициент = ПарамТовара.Коэффициент;			
			
			СтрокаТовара = Докум.Товары.Добавить();
			СтрокаТовара.Номенклатура = Стр.Номенклатура;
			Если ЗначениеЗаполнено(Стр.Характеристика) Тогда
				СтрокаТовара.Характеристика = Стр.Характеристика;
			КонецЕсли;
			СтрокаТовара.Склад = Стр.Склад; 
			Если (НЕ НужноПеремещение) И (Стр.Склад.Родитель <> Докум.Склад) Тогда
				НужноПеремещение = Истина;
			КонецЕсли;	
			СтрокаТовара.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
			
			СтрокаТовара.КоличествоУпаковок = Стр.КРезерву;
			СтрокаТовара.Упаковка = СтрокаТовара.Номенклатура.ЕдиницаИзмерения;
			СтрокаТовара.Цена = Цена;
			СтрокаТовара.Сумма = Окр(Цена * СтрокаТовара.КоличествоУпаковок, 2);
			СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма;
			СтрокаТовара.ДатаОтгрузки = Докум.Дата;
			СтрокаТовара.Количество = СтрокаТовара.КоличествоУпаковок * Коэффициент;
			СтрокаТовара.СтавкаНДС = СтрокаТовара.Номенклатура.СтавкаНДС;
			
			СтавкаНДС = СтрокаТовара.СтавкаНДС.Ставка;
			Если СтавкаНДС > 0 Тогда
				СтрокаТовара.СуммаНДС = Окр(СтрокаТовара.Сумма * СтавкаНДС / (100 + СтавкаНДС), 2);
			КонецЕсли;
			
			Всего = Всего + СтрокаТовара.СуммаСНДС;
		КонецЦикла;
		
		Если ОшибкаОстаткаКол > 0 Тогда
			Если ОшибкаОстаткаКол = 1 Тогда
				Ош = "Для товара: " + ОшибкаОстатка + " нет свободного остатка";
			ИначеЕсли ОшибкаОстаткаКол > 1 Тогда	                                          
				Ош ="Для товаров: " + ОшибкаОстатка + " нет свободного остатка";
			КонецЕсли;
			ВызватьИсключение(Ош);
		КонецЕсли;	
		Докум.СуммаДокумента = Всего;
		Докум.Записать(РежимЗаписиДокумента.Проведение);//Запись
		
		Если params.Получить("require_pay") = True Тогда
			ЭквайринговаяОперация = СоздатьЭквайринговуюОперацию(Докум.Ссылка);
		КонецЕсли;	
		
		ЗафиксироватьТранзакцию();		
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОписаниеОшибки();
    	ЗаписьЖурналаРегистрации("ECommerce", УровеньЖурналаРегистрации.Ошибка, , 
                            Докум, "Проведение ЗаказКлиента EcommerceID:"+EcommerceID+" "+ТекстОшибки);		
		//ВызватьИсключение;
		res.success = False;
		res.error = ТекстОшибки;
		Возврат;
	КонецПопытки;                 
	
	Результат.Вставить("order_ref", СсылкаНаДокумент1с(Докум.Ссылка));
	Результат.Вставить("need_transfer", НужноПеремещение);
	res.Вставить("payload", Результат);
КонецПроцедуры

