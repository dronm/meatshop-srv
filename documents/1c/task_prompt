КонецФункции

Функция УдалитьЭквайринговуюОперацию(ЗаказСсылка)

	ОбъектРасчетовСсылка = ПолучитьОбъектРасчетовПоЗаказуБезИсключения(ЗаказСсылка);

	Если ОбъектРасчетовСсылка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	НачатьТранзакцию();

	Попытка

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);
		Запрос.УстановитьПараметр("ОбъектРасчетовСсылка", ОбъектРасчетовСсылка);

		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		|	Экв.Ссылка КАК Ссылка,
		|	Экв.Проведен КАК Проведен,
		|	Экв.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.ОперацияПоПлатежнойКарте КАК Экв
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК РасшПлатежа
		|		ПО РасшПлатежа.Ссылка = Экв.Ссылка
		|ГДЕ
		|	РасшПлатежа.ОбъектРасчетов = &ОбъектРасчетовСсылка
		|	И РасшПлатежа.ОснованиеПлатежа = &ЗаказСсылка";

		Выборка = Запрос.Выполнить().Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ЭквСсылка = Выборка.Ссылка;
		ЭквПроведен = Выборка.Проведен;

		Если Выборка.Следующий() Тогда
			ВызватьИсключение "Найдено более одной эквайринговой операции для заказа " + Строка(ЗаказСсылка);
		КонецЕсли;

		Докум = ЭквСсылка.ПолучитьОбъект();

		Если ЭквПроведен Тогда
			Докум.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Докум = ЭквСсылка.ПолучитьОбъект();
		КонецЕсли;

		Докум.Удалить();

		ЗафиксироватьТранзакцию();

		Возврат Истина;

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;

КонецФункции

Функция СоздатьЭквайринговуюОперацию(ЗаказСсылка)

	УИД = Новый УникальныйИдентификатор(ДоговорЭквайрингаИД);
	ДоговорЭквайрингаСсылка = Справочники.ДоговорыЭквайринга.ПолучитьСсылку(УИД);

	ЗапросДоговор = Новый Запрос;
	ЗапросДоговор.УстановитьПараметр("ДоговорЭквайрингаСсылка", ДоговорЭквайрингаСсылка);
	ЗапросДоговор.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договор.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыЭквайринга КАК Договор
	|ГДЕ
	|	Договор.Ссылка = &ДоговорЭквайрингаСсылка";

	ВыборкаДоговор = ЗапросДоговор.Выполнить().Выбрать();
	Если НЕ ВыборкаДоговор.Следующий() Тогда
		ВызватьИсключение "Не найден договор эквайринга по ИД";
	КонецЕсли;

	ДоговорЭквайрингаСсылка = ВыборкаДоговор.Ссылка;
	ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	ОбъектРасчетовСсылка = ПолучитьОбъектРасчетовПоЗаказу(ЗаказСсылка);

	НачатьТранзакцию();

	Попытка

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка);
		Запрос.УстановитьПараметр("ОбъектРасчетовСсылка", ОбъектРасчетовСсылка);
		Запрос.УстановитьПараметр("Организация", ЗаказСсылка.Организация);
		Запрос.УстановитьПараметр("Контрагент", ЗаказСсылка.Контрагент);
		Запрос.УстановитьПараметр("ДоговорЭквайринга", ДоговорЭквайрингаСсылка);
		Запрос.УстановитьПараметр("ХозяйственнаяОперация", ХозяйственнаяОперация);
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ЗаказСсылка.Дата));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ЗаказСсылка.Дата));

		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		|	Экв.Ссылка КАК Ссылка,
		|	Экв.Проведен КАК Проведен,
		|	Экв.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.ОперацияПоПлатежнойКарте КАК Экв
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК РасшПлатежа
		|		ПО РасшПлатежа.Ссылка = Экв.Ссылка
		|ГДЕ
		|	Экв.Организация = &Организация
		|	И Экв.Контрагент = &Контрагент
		|	И Экв.ХозяйственнаяОперация = &ХозяйственнаяОперация
		|	И Экв.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И РасшПлатежа.ОбъектРасчетов = &ОбъектРасчетовСсылка
		|	И РасшПлатежа.ОснованиеПлатежа = &ЗаказСсылка
		|УПОРЯДОЧИТЬ ПО
		|	Экв.Дата УБЫВ";

		Докум = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда

			ЭквСсылка = Выборка.Ссылка;
			ЭквПроведен = Выборка.Проведен;
			ЭквПометкаУдаления = Выборка.ПометкаУдаления;

			Если Выборка.Следующий() Тогда
				ВызватьИсключение "Найдено более одной эквайринговой операции для заказа " + Строка(ЗаказСсылка);
			КонецЕсли;

			Докум = ЭквСсылка.ПолучитьОбъект();

			Если ЭквПометкаУдаления Тогда
				Докум.УстановитьПометкуУдаления(Ложь);
				Докум = ЭквСсылка.ПолучитьОбъект();
			КонецЕсли;

			Если ЭквПроведен Тогда
				Докум.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;

		Иначе

			Докум = Документы.ОперацияПоПлатежнойКарте.СоздатьДокумент();

		КонецЕсли;

		Докум.РасшифровкаПлатежа.Очистить();

		Докум.Дата = ЗаказСсылка.Дата;
		Докум.ХозяйственнаяОперация = ХозяйственнаяОперация;
		Докум.Организация = ЗаказСсылка.Организация;
		Докум.Контрагент = ЗаказСсылка.Контрагент;
		Докум.ДоговорЭквайринга = ДоговорЭквайрингаСсылка;
		Докум.СуммаДокумента = ЗаказСсылка.СуммаДокумента;
		Докум.Валюта = ВалютаРуб();
		Докум.НомерПлатежнойКарты = "0";
		Докум.ОплатаВыполнена = Ложь;
		Докум.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Докум.Комментарий = "Заказ интернет-магазина";
		Докум.НеКонтролироватьЗаполнениеЗаявки = Ложь;
		Докум.Партнер = ЗаказСсылка.Партнер;
		Докум.Договор = ЗаказСсылка.Договор;
		Докум.Автор = ЗаказСсылка.Автор;
		Докум.ОтражатьКомиссию = Ложь;
		Докум.РазрешеныПлатежиБезУказанияЗаявок = Ложь;

		ДокумСтр = Докум.РасшифровкаПлатежа.Добавить();
		ДокумСтр.Партнер = ЗаказСсылка.Партнер;
		ДокумСтр.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
		ДокумСтр.ОснованиеПлатежа = ЗаказСсылка;
		ДокумСтр.Сумма = Докум.СуммаДокумента;
		ДокумСтр.СуммаВзаиморасчетов = Докум.СуммаДокумента;
		ДокумСтр.ВалютаВзаиморасчетов = Докум.Валюта;
		ДокумСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
		ДокумСтр.СуммаНДС = Окр(Докум.СуммаДокумента * 22 / 122, 2);
		ДокумСтр.ОбъектРасчетов = ОбъектРасчетовСсылка;
		ДокумСтр.КурсЧислительВзаиморасчетов = 1;
		ДокумСтр.КурсЗнаменательВзаиморасчетов = 1;

		Докум.Записать(РежимЗаписиДокумента.Проведение);

		ДокументСсылка = Докум.Ссылка;

		ЗафиксироватьТранзакцию();

		Возврат ДокументСсылка;

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;

КонецФункции

Функция ПолучитьГотовыеКОтгрузкеЗаказы(ECommerceIds) Экспорт
	
	Результат = Новый Структура;
	ГотовыеЗаказы = Новый Массив;
	НеНайдены = Новый Массив;
	
	Результат.Вставить("ready", ГотовыеЗаказы);
	Результат.Вставить("not_found", НеНайдены);
	
	Если ECommerceIds = Неопределено Или ECommerceIds.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	НайденныеИдентификаторы = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.ECommerceId КАК ECommerceId,
	|	ЕСТЬNULL(ТоварыИтоги.КоличествоСтрок, 0) КАК КоличествоСтрок,
	|	ЕСТЬNULL(ТоварыИтоги.КоличествоНеГотовыхСтрок, 0) КАК КоличествоНеГотовыхСтрок
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|		(
	|			ВЫБРАТЬ
	|				ЗаказКлиентаТовары.Ссылка КАК ЗаказСсылка,
	|				КОЛИЧЕСТВО(*) КАК КоличествоСтрок,
	|				СУММА(
	|					ВЫБОР
	|						КОГДА ЗаказКлиентаТовары.ВариантОбеспечения = &ВариантОбеспеченияОтгрузить
	|							ТОГДА 0
	|						ИНАЧЕ 1
	|					КОНЕЦ
	|				) КАК КоличествоНеГотовыхСтрок
	|			ИЗ
	|				Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|			СГРУППИРОВАТЬ ПО
	|				ЗаказКлиентаТовары.Ссылка
	|		) КАК ТоварыИтоги
	|		ПО ТоварыИтоги.ЗаказСсылка = Заказы.Ссылка
	|ГДЕ
	|	Заказы.ECommerceId В (&ECommerceIds)";
	
	Запрос.УстановитьПараметр("ECommerceIds", ECommerceIds);
	Запрос.УстановитьПараметр(
		"ВариантОбеспеченияОтгрузить",
		Перечисления.ВариантыОбеспечения.Отгрузить
	);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеИдентификаторы.Вставить(Выборка.ECommerceId, Истина);
		
		Если Выборка.КоличествоСтрок > 0
			И Выборка.КоличествоНеГотовыхСтрок = 0 Тогда
			
			ГотовыеЗаказы.Добавить(Выборка.ECommerceId);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ECommerceId Из ECommerceIds Цикл
		
		Если НайденныеИдентификаторы.Получить(ECommerceId) = Неопределено Тогда
			НеНайдены.Добавить(ECommerceId);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокуПокупателя(Customer) Экспорт

	Если Customer = Неопределено Или Customer = Null Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;

	ДобавитьЗначениеПокупателяВМассив(Customer, "name", Части);
	ДобавитьЗначениеПокупателяВМассив(Customer, "email", Части);
	ДобавитьЗначениеПокупателяВМассив(Customer, "phone", Части);

	Возврат СтрСоединить(Части, ", ");

КонецФункции

Процедура ДобавитьЗначениеПокупателяВМассив(Customer, ИмяКлюча, Части)

	ЗначениеПоля = Неопределено;
	ЗначениеНайдено = Ложь;

	Для Каждого Элемент Из Customer Цикл

		Если Элемент.Ключ = ИмяКлюча Тогда
			ЗначениеПоля = Элемент.Значение;
			ЗначениеНайдено = Истина;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если Не ЗначениеНайдено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеПоля = Неопределено Или ЗначениеПоля = Null Тогда
		Возврат;
	КонецЕсли;

	ЗначениеСтрокой = СокрЛП(Строка(ЗначениеПоля));

	Если ЗначениеСтрокой = "" Тогда
		Возврат;
	КонецЕсли;

	Если ИмяКлюча = "email" Тогда

		Части.Добавить("email: " + ЗначениеСтрокой);

	ИначеЕсли ИмяКлюча = "phone" Тогда

		Части.Добавить("тел: " + ФорматироватьТелефонПокупателя(ЗначениеСтрокой));
		
	ИначеЕсли ИмяКлюча = "name" Тогда

		Части.Добавить("имя: " + ЗначениеСтрокой);

	Иначе

		Части.Добавить(ЗначениеСтрокой);

	КонецЕсли;

КонецПроцедуры

Функция ФорматироватьТелефонПокупателя(Телефон)

	Цифры = ПолучитьТолькоЦифры(Телефон);

	Если СтрДлина(Цифры) = 11 Тогда

		КодСтраны = Сред(Цифры, 1, 1);

		Если КодСтраны = "8" Тогда
			КодСтраны = "7";
		КонецЕсли;

		Возврат "+"
			+ КодСтраны
			+ "-("
			+ Сред(Цифры, 2, 3)
			+ ")-"
			+ Сред(Цифры, 5, 3)
			+ "-"
			+ Сред(Цифры, 8, 2)
			+ "-"
			+ Сред(Цифры, 10, 2);

	ИначеЕсли СтрДлина(Цифры) = 10 Тогда

		Возврат "+7-("
			+ Сред(Цифры, 1, 3)
			+ ")-"
			+ Сред(Цифры, 4, 3)
			+ "-"
			+ Сред(Цифры, 7, 2)
			+ "-"
			+ Сред(Цифры, 9, 2);

	КонецЕсли;

	Возврат Телефон;

КонецФункции

Функция ПолучитьТолькоЦифры(СтрокаТелефона)

	Результат = "";

	Для НомерСимвола = 1 По СтрДлина(СтрокаТелефона) Цикл

		Символ = Сред(СтрокаТелефона, НомерСимвола, 1);

		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлючНоменклатурыХарактеристики(Номенклатура, Характеристика)

	НоменклатураRef = СокрЛП(Номенклатура.УникальныйИдентификатор());

	Если ЗначениеЗаполнено(Характеристика) Тогда
		ХарактеристикаRef = СокрЛП(Характеристика.УникальныйИдентификатор());
	Иначе
		ХарактеристикаRef = "";
	КонецЕсли;

	Возврат НоменклатураRef + "|" + ХарактеристикаRef;

КонецФункции

Функция СуществуетРеализацияТоваровУслуг(Ссылка) Экспорт

