	contract_ref = params.Получить("contract_ref");
	Если ЗначениеЗаполнено(contract_ref) Тогда
		УИДДоговор = Новый УникальныйИдентификатор(contract_ref);
		Докум.Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИДДоговор);
	КонецЕсли;	

	УИДСоглашение = Новый УникальныйИдентификатор(params.Получить("agreement_ref"));
	Докум.Соглашение = Справочники.СоглашенияСКлиентами.ПолучитьСсылку(УИДСоглашение);

	Валюта = ВалютаРуб();

	Докум.Дата = ТекущаяДата();//ISO8601ВДату(params.Получить("date"));
