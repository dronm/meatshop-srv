Функция ПолучитьСтрокуJSON(Параметры, ИмяПоля, ЗначениеПоУмолчанию = "") Экспорт

	ЗначениеПоля = Неопределено;
	ЗначениеНайдено = Ложь;

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ЗначениеНайдено = Параметры.Свойство(ИмяПоля, ЗначениеПоля);
	ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ЗначениеПоля = Параметры.Получить(ИмяПоля);
		ЗначениеНайдено = ЗначениеПоля <> Неопределено;
	КонецЕсли;

	Если Не ЗначениеНайдено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ЗначениеПоля = Неопределено Или ЗначениеПоля = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат СокрЛП(Строка(ЗначениеПоля));

