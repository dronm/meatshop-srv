	Реализ.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;
	
	ДатаОтгрузки = Дата1сИзISO(params.Получить("date"));            

	shipment_count = params.Получить("shipment_count"); 
	Если shipment_count = 1 Тогда
		Реализ.Комментарий = "По отгрузке:" +params.Получить("shipment_nums");
	Иначе
		Реализ.Комментарий = "По отгрузкам:" +params.Получить("shipment_nums");
	КонецЕсли;			
	
	
	Всего =0;
	items = params.Получить("items");
	Если ЗначениеЗаполнено(items) Тогда
		Для Каждого Товар Из items Цикл
			code_1c = Товар.Получить("code_1c"); 
			Номенклатура = Справочники.Номенклатура.НайтиПоКоду(code_1c);
