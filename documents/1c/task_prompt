			СтрокаДокумента.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.Продажи_НДС;
			СтрокаДокумента.СчетРасходов = ПланыСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД;
			
			Всего = Всего + СтрокаДокумента.Сумма; 			
		КонецЦикла;
	КонецЕсли;	
	
	services = params.Получить("services");
	Если ЗначениеЗаполнено(services) Тогда
		Для Каждого Услуга Из services Цикл
