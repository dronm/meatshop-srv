Функция ДесятичнаяСтрокаЗаказа(
	ЗначениеЧисла,
	ИмяПоля,
	ЗнаковПослеЗапятой,
	МаксимумИсключительно
)
	Если ТипЗнч(ЗначениеЧисла) <> Тип("Число") Или ЗначениеЧисла < 0 Тогда
		ВызватьИсключение("Order line " + ИмяПоля + " must be a nonnegative number");
	КонецЕсли;

	ОкругленноеЗначение = Окр(ЗначениеЧисла, ЗнаковПослеЗапятой);
	Если ОкругленноеЗначение >= МаксимумИсключительно Тогда
		ВызватьИсключение("Order line " + ИмяПоля + " exceeds the backend numeric range");
	КонецЕсли;

	// Use a dot, no thousands separators, and explicit zero independently of locale.
	ПараметрыФормата = "ЧГ=0;ЧРД=.;ЧН=0;ЧДЦ=" + Строка(ЗнаковПослеЗапятой);
	Возврат СокрЛП(Формат(ОкругленноеЗначение, ПараметрыФормата));
КонецФункции

Функция ДанныеСтрокСчета1С(Счет)
	Если Счет.Товары.Количество() = 0 Тогда
		ВызватьИсключение("The saved order must contain at least one product");
	КонецЕсли;

	Результат = Новый Массив;
	ИдентификаторыСтрок = Новый Соответствие;
	Для Каждого СтрокаСчета Из Счет.Товары Цикл
		ИдентификаторСтроки = ПолучитьПоложительноеЦелое(
			Новый Структура("order_item_id", СтрокаСчета.order_item_id),
			"order_item_id"
		);
		Если ИдентификаторыСтрок.Получить(ИдентификаторСтроки) <> Неопределено Тогда
			ВызватьИсключение("The saved order contains duplicate order_item_id values");
		КонецЕсли;
		ИдентификаторыСтрок.Вставить(ИдентификаторСтроки, Истина);

		ПроцентНДС = ПолучитьПроцентНДССтрокиСчета(СтрокаСчета, Счет);
		Если ТипЗнч(ПроцентНДС) <> Тип("Число")
			ИЛИ ПроцентНДС < 0 ИЛИ ПроцентНДС > 100 Тогда
			ВызватьИсключение("Order line vat_percent must be a number between 0 and 100");
		КонецЕсли;
		ИспользоватьМаркировку = ПолучитьМаркировкуСтрокиСчета(СтрокаСчета, Счет);
		Если ТипЗнч(ИспользоватьМаркировку) <> Тип("Булево") Тогда
			ВызватьИсключение("Order line use_marking must be a Boolean");
		КонецЕсли;

		// Wire price and amount are VAT-inclusive, even for a net-price document.
		ЦенаСНДС = СтрокаСчета.Цена;
		СуммаСНДС = СтрокаСчета.Сумма;
		Если Не Счет.СуммаВключаетНДС Тогда
			ЦенаСНДС = ЦенаСНДС * (1 + ПроцентНДС / 100);
			СуммаСНДС = СуммаСНДС + СтрокаСчета.СуммаНДС;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("order_item_id", ИдентификаторСтроки);
		Элемент.Вставить(
			"price",
			ДесятичнаяСтрокаЗаказа(ЦенаСНДС, "price", 6, 10000000000000)
		);
		Элемент.Вставить(
			"amount",
			ДесятичнаяСтрокаЗаказа(СуммаСНДС, "amount", 2, 10000000000000)
		);
		Элемент.Вставить(
			"vat_percent",
			ДесятичнаяСтрокаЗаказа(ПроцентНДС, "vat_percent", 2, 1000)
		);
		Элемент.Вставить(
			"vat_amount",
			ДесятичнаяСтрокаЗаказа(СтрокаСчета.СуммаНДС, "vat_amount", 2, 10000000000000)
		);
		Элемент.Вставить("use_marking", ИспользоватьМаркировку);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ДанныеСчета1С(СсылкаНаСчет)
	// Read saved line values after document write/posting handlers have completed.
	Счет = СсылкаНаСчет.ПолучитьОбъект();
	Результат = Новый Структура;
	Результат.Вставить(
		"id",
		СокрЛП(Строка(СсылкаНаСчет.УникальныйИдентификатор()))
	);
	Результат.Вставить("descr", СокрЛП(Строка(СсылкаНаСчет)));
	Результат.Вставить("number_1c", СокрЛП(Строка(СсылкаНаСчет.Номер)));
	Результат.Вставить("items", ДанныеСтрокСчета1С(Счет));

	Возврат Результат;
КонецФункции

// Command: create_order.
// Arguments:
//   СтрокаПараметров - a JSON string containing the params object below.
//   Ответ - the mutable response structure; this handler fills Ответ.payload.
// Required JSON fields:
//   order_id - Number: positive integer; the local Meatshop order ID.
//   order_version - Number: positive integer; the local order revision.
//   customer_id - String: UUID of an existing, active 1C counterparty element.
//   products - Array: at least one object with all of these required fields:
//     order_item_id - Number: positive integer; the local order line ID.
//       Must be unique within products; product UUIDs may repeat.
//     id - String: UUID of an existing, active 1C product element.
//     quant - Number: quantity greater than or equal to zero.
// Example params:
// {
//	"order_id": 101,
//	"order_version": 2,
//	"customer_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
//	"products": [
//		{
//			"order_item_id": 201,
//			"id": "11111111-aaaa-bbbb-cccc-222222222222",
//			"quant": 2
//		}
//	]
// }
// Payload: {id, descr, number_1c, items}; each item echoes order_item_id,
// decimal strings price/amount/vat_percent/vat_amount, and Boolean use_marking.
Процедура ВыполнитьСозданиеЗаказа(СтрокаПараметров, Ответ)
	Параметры = ParseJSON(СтрокаПараметров);
	НомерЗаказа = ПолучитьПоложительноеЦелое(Параметры, "order_id");
	ВерсияЗаказа = ПолучитьПоложительноеЦелое(Параметры, "order_version");

	ИдентификаторКонтрагента = ПолучитьУникальныйИдентификатор(
		Параметры,
		"customer_id"
	);
	Контрагент = ПолучитьКонтрагентаПоИдентификатору(
		ИдентификаторКонтрагента
	);
	ТоварыJSON = ПолучитьОбязательныйМассив(Параметры, "products");
	Товары = ПодготовитьТоварыЗаказа(ТоварыJSON);

	ТранзакцияНачата = Ложь;
	Попытка
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		ТранзакцияНачата = Истина;

		ЗаблокироватьЗаказПоOrderID(НомерЗаказа);
		СсылкаНаСчет = НайтиСчетПоOrderID(НомерЗаказа);
		НужноЗаписатьСчет = Истина;

		Если СсылкаНаСчет = Неопределено Тогда
			Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
		Иначе
			Счет = СсылкаНаСчет.ПолучитьОбъект();
			Если ТипЗнч(Счет.order_version) <> Тип("Число")
				ИЛИ Счет.order_version < 0
				ИЛИ Цел(Счет.order_version) <> Счет.order_version Тогда
				ВызватьИсключение("The stored order_version must be a nonnegative integer");
			КонецЕсли;
			Если ВерсияЗаказа < Счет.order_version Тогда
				ВызватьИсключение("The incoming order_version is older than the saved order");
			КонецЕсли;
			Если ВерсияЗаказа = Счет.order_version Тогда
				Если Счет.ПометкаУдаления Тогда
					ВызватьИсключение("The saved order is marked for deletion");
				КонецЕсли;
				// A retry returns the saved calculation without pricing or rewriting again.
				ПроверитьДанныеПовторногоЗаказа(Счет, Контрагент, Товары);
				НужноЗаписатьСчет = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		//Resolve ТипЦен
		Счет.ТипЦен = ПолучитьТипЦенКлиента(Контрагент,Счет.Дата);
		
		Если НужноЗаписатьСчет Тогда
			Если Счет.ПометкаУдаления Тогда
				Счет.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			Если Счет.Проведен Тогда
				Счет.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;

			Счет.order_id = НомерЗаказа;
			Счет.order_version = ВерсияЗаказа;
			Счет.Товары.Очистить();
			ЗаполнитьШапкуСчета(Счет, Контрагент, НомерЗаказа);

			СуммаДокумента = 0;
			Для Каждого Товар Из Товары Цикл
				СтрокаСчета = Счет.Товары.Добавить();
				ЗаполнитьСтрокуСчетаПоУмолчанию(
					СтрокаСчета,
					Товар.Номенклатура,
					Товар.Количество,
					Счет.Дата,
					Счет.ТипЦен
				);
				СтрокаСчета.order_item_id = Товар.order_item_id;
				СуммаДокумента = СуммаДокумента + СтрокаСчета.Сумма;
			КонецЦикла;

			Счет.СуммаДокумента = СуммаДокумента;
			ЗаписатьСчет(Счет);

			ПроверочнаяСсылка = НайтиСчетПоOrderID(НомерЗаказа);
			Если ПроверочнаяСсылка = Неопределено
				ИЛИ ПроверочнаяСсылка <> Счет.Ссылка Тогда
				ВызватьИсключение(
					"Failed to preserve unique order_id=" + Строка(НомерЗаказа)
				);
			КонецЕсли;

			СохраненныйСчет = Счет.Ссылка.ПолучитьОбъект();
			Если СохраненныйСчет.order_id <> НомерЗаказа
				ИЛИ СохраненныйСчет.order_version <> ВерсияЗаказа Тогда
				ВызватьИсключение("Document handlers changed order_id or order_version");
			КонецЕсли;
			ПроверитьДанныеПовторногоЗаказа(СохраненныйСчет, Контрагент, Товары);
		КонецЕсли;

		// Build and validate the full response before committing the document.
		ДанныеСчета = ДанныеСчета1С(Счет.Ссылка);
		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;
	Исключение
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Ответ.Вставить("payload", ДанныеСчета);
КонецПроцедуры

#КонецОбласти

#Область ПечатнаяФормаЗаказа

Функция ПолучитьСчетПоИдентификатору(Идентификатор)
	ПредполагаемаяСсылка = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(
		Идентификатор
	);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.Ссылка = &Ссылка
	|	И НЕ Счета.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", ПредполагаемаяСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("Invoice was not found by UUID");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

// Command: order_print_form (legacy single-invoice printing).
// Arguments:
//   СтрокаПараметров - a JSON string containing the params object below.
//   Ответ - the mutable response structure; this handler fills Ответ.payload.
// Required JSON fields:
//   order_id - String: UUID of an existing 1C invoice not marked for deletion.
//     This is the id returned by create_order, not the numeric local order ID.
// Example params:
// {
//	"order_id": "11111111-2222-3333-4444-555555555555"
// }
// Payload: a server-side PDF file path consumed by goCOM1c /bin-data.
Процедура ВыполнитьПечатьЗаказа(СтрокаПараметров, Ответ)
	// Compatibility only: order_id here is a 1C UUID, not a local numeric ID.
	Параметры = ParseJSON(СтрокаПараметров);
	ИдентификаторСчета = ПолучитьУникальныйИдентификатор(Параметры, "order_id");
	СсылкаНаСчет = ПолучитьСчетПоИдентификатору(ИдентификаторСчета);
	ТабличныйДокумент = ПолучитьПечатнуюФормуСчета(СсылкаНаСчет);
	Ответ.Вставить("payload", СохранитьПечатнуюФормуPDF(ТабличныйДокумент));
КонецПроцедуры

#КонецОбласти

#Область ПакетыЗаказов

Функция ПолучитьНомераЗаказов(СтрокаПараметров)
	Параметры = ParseJSON(СтрокаПараметров);
	НомераЗаказов = ПолучитьОбязательныйМассив(Параметры, "order_ids");
	Если НомераЗаказов.Количество() = 0 Тогда
		ВызватьИсключение("order_ids must contain at least one order");
	КонецЕсли;

	УникальныеНомера = Новый Соответствие;
	Для Каждого НомерЗаказа Из НомераЗаказов Цикл
		Если ТипЗнч(НомерЗаказа) <> Тип("Число") Тогда
			ВызватьИсключение("Every order_ids entry must be a positive integer");
		КонецЕсли;
		Если НомерЗаказа <= 0 Или Цел(НомерЗаказа) <> НомерЗаказа Тогда
			ВызватьИсключение("Every order_ids entry must be a positive integer");
		КонецЕсли;
		Если УникальныеНомера.Получить(НомерЗаказа) <> Неопределено Тогда
			ВызватьИсключение("Duplicate order_ids entry: " + Строка(НомерЗаказа));
		КонецЕсли;
		УникальныеНомера.Вставить(НомерЗаказа, Истина);
	КонецЦикла;

	// Preserve the incoming order for response rows and combined PDF pages.
	Возврат НомераЗаказов;
КонецФункции

Функция ОтсортированныеНомераЗаказов(НомераЗаказов)
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("НомерЗаказа", Новый ОписаниеТипов("Число"));
	Для Каждого НомерЗаказа Из НомераЗаказов Цикл
		СтрокаНомера = ТаблицаНомеров.Добавить();
		СтрокаНомера.НомерЗаказа = НомерЗаказа;
	КонецЦикла;
	ТаблицаНомеров.Сортировать("НомерЗаказа Возр");

	Возврат ТаблицаНомеров.ВыгрузитьКолонку("НомерЗаказа");
КонецФункции

Функция ПолучитьСчетПоOrderID(НомерЗаказа)
	СсылкаНаСчет = НайтиСчетПоOrderID(НомерЗаказа);
	Если СсылкаНаСчет = Неопределено Тогда
		ВызватьИсключение("Invoice was not found for order_id=" + Строка(НомерЗаказа));
	КонецЕсли;
	Если СсылкаНаСчет.ПометкаУдаления Тогда
		ВызватьИсключение("Invoice is marked for deletion for order_id=" + Строка(НомерЗаказа));
	КонецЕсли;

	Возврат СсылкаНаСчет;
КонецФункции

#КонецОбласти

#Область НастройкиОтгрузки

Функция СоздатьОтгрузкуНаОснованииСчета(СсылкаНаСчет, НомерЗаказа)
	// TODO: adapt this document type and the three fill/save helpers to your 1C configuration.
	Отгрузка = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Отгрузка.Заполнить(СсылкаНаСчет);
	Счет = СсылкаНаСчет.ПолучитьОбъект();
	ЗаполнитьШапкуОтгрузки(Отгрузка, Счет, НомерЗаказа);

	Отгрузка.Товары.Очистить();
	Для Каждого СтрокаСчета Из Счет.Товары Цикл
		СтрокаОтгрузки = Отгрузка.Товары.Добавить();
		ЗаполнитьСтрокуОтгрузки(СтрокаОтгрузки, СтрокаСчета);
	КонецЦикла;
	Отгрузка.СуммаДокумента = Счет.СуммаДокумента;

	Возврат Отгрузка;
КонецФункции

Процедура ЗаполнитьШапкуОтгрузки(Отгрузка, Счет, НомерЗаказа)
	// TODO: adapt the basis/header attributes; all orchestration is outside this helper.
	Отгрузка.Дата = ТекущаяДата();
	Отгрузка.Организация = Счет.Организация;
	Отгрузка.Склад = Счет.Склад;
	Отгрузка.Контрагент = Счет.Контрагент;
	Отгрузка.ДоговорКонтрагента = Счет.ДоговорКонтрагента;
	Отгрузка.ВалютаДокумента = Счет.ВалютаДокумента;
	Отгрузка.СуммаВключаетНДС = Счет.СуммаВключаетНДС;
	Отгрузка.КратностьВзаиморасчетов = Счет.КратностьВзаиморасчетов;
	Отгрузка.КурсВзаиморасчетов = Счет.КурсВзаиморасчетов;
	Отгрузка.СчетНаОплатуПокупателю = Счет.Ссылка;
	Отгрузка.Ответственный = Пользователи.ТекущийПользователь();
	Отгрузка.Комментарий = "Отгрузка для заказа" + Строка(НомерЗаказа);
КонецПроцедуры

Процедура ЗаполнитьСтрокуОтгрузки(СтрокаОтгрузки, СтрокаСчета)
	// TODO: add units, stock dimensions, marking data, and other required attributes.
	СтрокаОтгрузки.Номенклатура = СтрокаСчета.Номенклатура;
	СтрокаОтгрузки.Количество = СтрокаСчета.Количество;
	СтрокаОтгрузки.Цена = СтрокаСчета.Цена;
	СтрокаОтгрузки.Сумма = СтрокаСчета.Сумма;
	СтрокаОтгрузки.СтавкаНДС = СтрокаСчета.СтавкаНДС;
	СтрокаОтгрузки.СуммаНДС = СтрокаСчета.СуммаНДС;
КонецПроцедуры

Процедура ЗаписатьОтгрузку(Отгрузка)
	// TODO: use РежимЗаписиДокумента.Проведение after filling all required attributes.
	Отгрузка.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

Функция ПолучитьПечатнуюФормуОтгрузки(СсылкаНаОтгрузку)
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(СсылкаНаОтгрузку);

	ИмяМенеджераПечати = "Обработка.ПечатьУПД";
	ИменаМакетов = "ПФ_MXL_УниверсальныйПередаточныйДокумент26"; // либо нужный вам вариант макета УПД
	ПараметрыПечати = Новый Структура();

	// Формируем коллекцию печатных форм
	КоллекцияПечатныхФорм = Неопределено;
	ОбъектыПечати = Неопределено;

	УправлениеПечатью.СформироватьПечатныеФормы(
	    ИмяМенеджераПечати, 
	    ИменаМакетов, 
	    МассивОбъектов, 
	    ПараметрыПечати, 
	    КоллекцияПечатныхФорм, 
	    ОбъектыПечати
	);

	// Получаем сформированный табличный документ
	Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
	    Возврат КоллекцияПечатныхФорм[0].ТабличныйДокумент;
	КонецЕсли;  
	
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СозданиеОтгрузок

Функция НайтиОтгрузкуПоOrderID(НомерЗаказа)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Отгрузки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Отгрузки
	|ГДЕ
	|	Отгрузки.order_id = &order_id";
	Запрос.УстановитьПараметр("order_id", НомерЗаказа);

	Выборка = Запрос.Выполнить().Выбрать();
	СсылкаНаОтгрузку = Неопределено;
	Если Выборка.Следующий() Тогда
		СсылкаНаОтгрузку = Выборка.Ссылка;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение("More than one shipment has order_id=" + Строка(НомерЗаказа));
		КонецЕсли;
	КонецЕсли;

	Возврат СсылкаНаОтгрузку;
КонецФункции

Функция ПолучитьОтгрузкуПоOrderID(НомерЗаказа)
	СсылкаНаОтгрузку = НайтиОтгрузкуПоOrderID(НомерЗаказа);
	Если СсылкаНаОтгрузку = Неопределено Тогда
		ВызватьИсключение("Shipment was not found for order_id=" + Строка(НомерЗаказа));
	КонецЕсли;
	Если СсылкаНаОтгрузку.ПометкаУдаления Тогда
		ВызватьИсключение("Shipment is marked for deletion for order_id=" + Строка(НомерЗаказа));
	КонецЕсли;

	Возврат СсылкаНаОтгрузку;
КонецФункции

Функция ДанныеОтгрузки1С(НомерЗаказа, СсылкаНаОтгрузку)
	Результат = Новый Структура;
	Результат.Вставить("order_id", НомерЗаказа);
	Результат.Вставить("id", СокрЛП(Строка(СсылкаНаОтгрузку.УникальныйИдентификатор())));
	Результат.Вставить("descr", СокрЛП(Строка(СсылкаНаОтгрузку)));

	Возврат Результат;
КонецФункции

// Command: create_shipments.
// Arguments:
//   СтрокаПараметров - a JSON string containing the params object below.
//   Ответ - the mutable response structure; this handler fills Ответ.payload.
// Required JSON fields:
//   order_ids - Array of Numbers: nonempty list of unique positive integers.
//     Each entry is a local Meatshop order ID with an existing 1C invoice.
//     These IDs are numeric document order_id requisites, not 1C UUIDs.
// Example params:
// {
//	"order_ids": [101, 102]
// }
// Creates one shipment per order; retries return existing shipment references.
// Payload: an array of {order_id, id, descr} in the requested order.
Процедура ВыполнитьСозданиеОтгрузок(СтрокаПараметров, Ответ)
	НомераЗаказов = ПолучитьНомераЗаказов(СтрокаПараметров);
	ПорядокБлокировок = ОтсортированныеНомераЗаказов(НомераЗаказов);
	Счета = Новый Соответствие;
	Отгрузки = Новый Соответствие;
	Результат = Новый Массив;

	ТранзакцияНачата = Ложь;
	Попытка
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		ТранзакцияНачата = Истина;

		// Acquire each shared order key once, in ascending order, before any lookup.
		// This prevents overlapping/reversed batches from taking opposite lock orders.
		Для Каждого НомерЗаказа Из ПорядокБлокировок Цикл
			ЗаблокироватьЗаказПоOrderID(НомерЗаказа);
		КонецЦикла;

		// Resolve the entire batch before creating any document.
		Для Каждого НомерЗаказа Из НомераЗаказов Цикл
			Счета.Вставить(НомерЗаказа, ПолучитьСчетПоOrderID(НомерЗаказа));
			СсылкаНаОтгрузку = НайтиОтгрузкуПоOrderID(НомерЗаказа);
			Если СсылкаНаОтгрузку <> Неопределено Тогда
				Если СсылкаНаОтгрузку.ПометкаУдаления Тогда
					ВызватьИсключение("Shipment is marked for deletion for order_id=" + Строка(НомерЗаказа));
				КонецЕсли;
				Отгрузки.Вставить(НомерЗаказа, СсылкаНаОтгрузку);
			КонецЕсли;
		КонецЦикла;

		Для Каждого НомерЗаказа Из НомераЗаказов Цикл
			СсылкаНаОтгрузку = Отгрузки.Получить(НомерЗаказа);
			Если СсылкаНаОтгрузку = Неопределено Тогда
				Отгрузка = СоздатьОтгрузкуНаОснованииСчета(Счета.Получить(НомерЗаказа), НомерЗаказа);
				Отгрузка.order_id = НомерЗаказа;
				ЗаписатьОтгрузку(Отгрузка);
				СсылкаНаОтгрузку = Отгрузка.Ссылка;
			КонецЕсли;

			Если НайтиОтгрузкуПоOrderID(НомерЗаказа) <> СсылкаНаОтгрузку Тогда
				ВызватьИсключение("Failed to preserve unique shipment order_id=" + Строка(НомерЗаказа));
			КонецЕсли;
			// A retry returns the existing reference without rewriting a saved shipment.
			Результат.Добавить(ДанныеОтгрузки1С(НомерЗаказа, СсылкаНаОтгрузку));
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;
	Исключение
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Ответ.Вставить("payload", Результат);
КонецПроцедуры

#КонецОбласти

#Область ПакетныеПечатныеФормы

Функция ПолучитьПечатнуюФормуСчета(СсылкаНаСчет)
	// Keep the original configuration's invoice print routine in one adapter.
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыПечати = Новый Структура;
	СведенияСчета = Документы.СчетНаОплатуПокупателю.ПолучитьТаблицуСведенийСчетаНаОплату(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаСчет)
	);

	Возврат ПечатьТорговыхДокументов.ПечатьСчетаНаОплату(
		СведенияСчета,
		ОбъектыПечати,
		ПараметрыПечати
	);
КонецФункции

Процедура ПроверитьПечатнуюФорму(ТабличныйДокумент)
	Если ТипЗнч(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
		ВызватьИсключение("1C print routine must return a ТабличныйДокумент");
	КонецЕсли;
	Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		ВызватьИсключение("1C returned an empty print form");
	КонецЕсли;
КонецПроцедуры

Функция СохранитьПечатнуюФормуPDF(ТабличныйДокумент)
	ПроверитьПечатнуюФорму(ТабличныйДокумент);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
	Попытка
		ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
		ФайлПечатнойФормы = Новый Файл(ИмяВременногоФайла);
		Если Не ФайлПечатнойФормы.Существует() Тогда
			ВызватьИсключение("1C did not create a PDF file");
		КонецЕсли;
		Если ФайлПечатнойФормы.Размер() = 0 Тогда
			ВызватьИсключение("1C created an empty PDF file");
		КонецЕсли;
	Исключение
		// Successful files are consumed by goCOM1c. Remove only failed output here.
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			// Preserve the original generation error if cleanup also fails.
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;

	Возврат ИмяВременногоФайла;
КонецФункции

Функция ОбъединитьПечатныеФормы(СсылкиДокументов, ПечатьОтгрузок)
	Результат = Неопределено;
	Для Каждого СсылкаДокумента Из СсылкиДокументов Цикл
		Если ПечатьОтгрузок Тогда
			ПечатнаяФорма = ПолучитьПечатнуюФормуОтгрузки(СсылкаДокумента);
		Иначе
			ПечатнаяФорма = ПолучитьПечатнуюФормуСчета(СсылкаДокумента);
		КонецЕсли;
		ПроверитьПечатнуюФорму(ПечатнаяФорма);

		Если Результат = Неопределено Тогда
			// Retain the first form's paper size, orientation, margins, and scale.
			Результат = ПечатнаяФорма;
		Иначе
			// A combined tabular document shares print settings across its pages.
			// TODO: use uniform settings in both print adapters if layouts differ.
			Результат.ВывестиГоризонтальныйРазделительСтраниц();
			Результат.Вывести(ПечатнаяФорма);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Commands: print_order and print_shipment.
// Arguments:
//   СтрокаПараметров - a JSON string containing the params object below.
//   Ответ - the mutable response structure; this handler fills Ответ.payload.
//   ПечатьОтгрузок - Boolean supplied by ExecuteCommand, not a JSON field:
//     Ложь for print_order (invoices); Истина for print_shipment (shipments).
// Required JSON fields for both commands:
//   order_ids - Array of Numbers: nonempty list of unique positive integers.
//     Each entry is a local Meatshop order ID, not a 1C document UUID.
//     print_order requires the corresponding invoice; print_shipment requires
//     the corresponding shipment. Documents must not be marked for deletion.
// Example params for either command:
// {
//	"order_ids": [101, 102]
// }
// Payload: a server-side path to one combined PDF, in the requested order,
// consumed by goCOM1c /bin-data. This handler does not create missing documents.
Процедура ВыполнитьПакетнуюПечать(СтрокаПараметров, Ответ, ПечатьОтгрузок)
	НомераЗаказов = ПолучитьНомераЗаказов(СтрокаПараметров);
	СсылкиДокументов = Новый Массив;
	Для Каждого НомерЗаказа Из НомераЗаказов Цикл
		Если ПечатьОтгрузок Тогда
			СсылкаДокумента = ПолучитьОтгрузкуПоOrderID(НомерЗаказа);
		Иначе
			СсылкаДокумента = ПолучитьСчетПоOrderID(НомерЗаказа);
		КонецЕсли;
		СсылкиДокументов.Добавить(СсылкаДокумента);
	КонецЦикла;

	ТабличныйДокумент = ОбъединитьПечатныеФормы(СсылкиДокументов, ПечатьОтгрузок);
	// /bin-data reads this server-side path and sends its contents to the backend.
	Ответ.Вставить("payload", СохранитьПечатнуюФормуPDF(ТабличныйДокумент));
КонецПроцедуры

#КонецОбласти


#Область ВыполнениеКоманд

// Public entry point called by goCOM1c.
// Arguments:
//   Команда - String: complete_catalogue, create_order, create_shipments,
//     print_order, print_shipment, or legacy order_print_form.
//   Параметры - String: serialized JSON params object for the selected command.
//     Pass only the inner params object here, without the HTTP command envelope.
//     Required fields and examples are documented above the corresponding handler.
// Returns a JSON string: {success, error, payload}; on failure payload is absent.
// Handler exceptions become success=false and error contains their description.
Функция ExecuteCommand(Команда, Параметры) Экспорт
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("error", "");

	Попытка
		Если Команда = "complete_catalogue" Тогда
			ВыполнитьАвтодополнениеСправочника(Параметры, Ответ);
		ИначеЕсли Команда = "create_order" Тогда
			ВыполнитьСозданиеЗаказа(Параметры, Ответ);
		ИначеЕсли Команда = "create_shipments" Тогда
			ВыполнитьСозданиеОтгрузок(Параметры, Ответ);
		ИначеЕсли Команда = "print_order" Тогда
			ВыполнитьПакетнуюПечать(Параметры, Ответ, Ложь);
		ИначеЕсли Команда = "print_shipment" Тогда
			ВыполнитьПакетнуюПечать(Параметры, Ответ, Истина);
		ИначеЕсли Команда = "order_print_form" Тогда
			ВыполнитьПечатьЗаказа(Параметры, Ответ);
		Иначе
			ВызватьИсключение("Command not found: " + Команда);
		КонецЕсли;
	Исключение
		Ответ.success = Ложь;
		Ответ.error = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"MyasmastersIntegration1C",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Команда + ": " + Ответ.error
		);
	КонецПопытки;

	Возврат SerializeJSON(Ответ);
КонецФункции

