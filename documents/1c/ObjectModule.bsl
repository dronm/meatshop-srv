Процедура ЗаблокироватьЗаказПоOrderID(НомерЗаказа)
	// Call inside the managed transaction, before invoice/shipment lookup.
	// One shared key also protects first creation when neither document exists.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.MeatshopOrderLocks"
	);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("OrderID", НомерЗаказа);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция НайтиСчетПоOrderID(НомерЗаказа)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.order_id = &order_id";
	Запрос.УстановитьПараметр("order_id", НомерЗаказа);

	Выборка = Запрос.Выполнить().Выбрать();
	СсылкаНаСчет = Неопределено;
	Если Выборка.Следующий() Тогда
		СсылкаНаСчет = Выборка.Ссылка;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение(
				"More than one invoice has order_id=" + Строка(НомерЗаказа)
			);
		КонецЕсли;
	КонецЕсли;

	Возврат СсылкаНаСчет;
КонецФункции

Функция ПодготовитьТоварыЗаказа(ТоварыJSON)
	Если ТоварыJSON.Количество() = 0 Тогда
		ВызватьИсключение("The order must contain at least one product");
	КонецЕсли;

	Результат = Новый Массив;
	ИдентификаторыСтрок = Новый Соответствие;
	НомерСтроки = 0;
	Для Каждого ТоварJSON Из ТоварыJSON Цикл
		НомерСтроки = НомерСтроки + 1;

		Если ТипЗнч(ТоварJSON) <> Тип("Структура")
			И ТипЗнч(ТоварJSON) <> Тип("Соответствие") Тогда
			ВызватьИсключение(
				"Product at index " + Строка(НомерСтроки) + " must be an object"
			);
		КонецЕсли;

		Идентификатор = ПолучитьУникальныйИдентификатор(ТоварJSON, "id");
		Номенклатура = ПолучитьНоменклатуруПоИдентификатору(Идентификатор);
		Количество = ПолучитьНеотрицательноеЧислоЗаказа(ТоварJSON, "quant");
		ИдентификаторСтроки = ПолучитьПоложительноеЦелое(
			ТоварJSON,
			"order_item_id"
		);
		Если ИдентификаторыСтрок.Получить(ИдентификаторСтроки) <> Неопределено Тогда
			ВызватьИсключение(
				"Duplicate order_item_id=" + Строка(ИдентификаторСтроки)
			);
		КонецЕсли;
		ИдентификаторыСтрок.Вставить(ИдентификаторСтроки, Истина);

		Товар = Новый Структура;
		Товар.Вставить("order_item_id", ИдентификаторСтроки);
		Товар.Вставить("Номенклатура", Номенклатура);
		Товар.Вставить("Количество", Количество);
		Результат.Добавить(Товар);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПолучитьНеотрицательноеЧислоЗаказа(Параметры, ИмяПараметра)
	ЗначениеПараметра = ПолучитьПараметрJSON(Параметры, ИмяПараметра);
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Число")
		ИЛИ ЗначениеПараметра < 0 Тогда
		ВызватьИсключение(
			"Parameter must be a nonnegative number: " + ИмяПараметра
		);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Процедура ПроверитьДанныеПовторногоЗаказа(Счет, Контрагент, Товары)
	Если Счет.Контрагент <> Контрагент Тогда
		ВызватьИсключение("The stored order customer differs from the request");
	КонецЕсли;
	Если Счет.Товары.Количество() <> Товары.Количество() Тогда
		ВызватьИсключение("The stored order line count differs from the request");
	КонецЕсли;

	ТоварыПоИдентификатору = Новый Соответствие;
	Для Каждого Товар Из Товары Цикл
		ТоварыПоИдентификатору.Вставить(Товар.order_item_id, Товар);
	КонецЦикла;
	ПроверенныеСтроки = Новый Соответствие;
	Для Каждого СтрокаСчета Из Счет.Товары Цикл
		Товар = ТоварыПоИдентификатору.Получить(СтрокаСчета.order_item_id);
		Если Товар = Неопределено Тогда
			ВызватьИсключение("The stored order contains an unexpected order_item_id");
		КонецЕсли;
		Если ПроверенныеСтроки.Получить(СтрокаСчета.order_item_id) <> Неопределено Тогда
			ВызватьИсключение("The stored order contains duplicate order_item_id values");
		КонецЕсли;
		Если СтрокаСчета.Номенклатура <> Товар.Номенклатура
			ИЛИ СтрокаСчета.Количество <> Товар.Количество Тогда
			ВызватьИсключение(
				"The stored product or quantity differs for order_item_id="
					+ Строка(СтрокаСчета.order_item_id)
			);
		КонецЕсли;
		ПроверенныеСтроки.Вставить(СтрокаСчета.order_item_id, Истина);
	КонецЦикла;
КонецПроцедуры

