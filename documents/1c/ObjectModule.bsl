Функция ПолучитьТипЦенКлиента(Контрагент, Дата)
	Возврат Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию(ТипыЦенНоменклатурыНаименование);
КонецФункции


Функция ПолучитьПервыйАктивныйДоговор(Контрагент)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И НЕ Договоры.ПометкаУдаления
	|	И Договоры.ВидДоговора =
	|		ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|УПОРЯДОЧИТЬ ПО
	|	Договоры.Код,
	|	Договоры.Ссылка";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение(
			"No active contract was found for customer " + Строка(Контрагент)
		);
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Функция ПолучитьВалютуРубль()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Код = &Код
	|	И НЕ Валюты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", "643");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("RUB currency with code 643 was not found");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Процедура ЗаполнитьШапкуСчета(Счет, Контрагент, НомерЗаказа)
	Организация = ПолучитьОрганизациюДляЗаказа();
	Если Не ЗначениеЗаполнено(Организация) Или Организация.Пустая() Тогда
		ВызватьИсключение("The organization for the order is not configured");
	КонецЕсли;

	Склад = ПолучитьСкладДляЗаказа();
	Если Не ЗначениеЗаполнено(Склад) Или Склад.Пустая() Тогда
		ВызватьИсключение("The warehouse for the order is not configured");
	КонецЕсли;

	Счет.Дата = ТекущаяДата();
	Счет.Организация = Организация;
	Счет.ОрганизацияПолучатель = Организация;
	Счет.Склад = Склад;
	Счет.ВидОперации = Перечисления.ВидыОперацийСчетаПокупателю.ТоварыИУслуги;
	Счет.Контрагент = Контрагент;
	Счет.ДоговорКонтрагента = ПолучитьПервыйАктивныйДоговор(Контрагент);
	Счет.ВалютаДокумента = ПолучитьВалютуРубль();
	Счет.СуммаВключаетНДС = Истина;
	Счет.КратностьВзаиморасчетов = 1;
	Счет.КурсВзаиморасчетов = 1;
	Счет.Ответственный = Пользователи.ТекущийПользователь();
	Счет.Комментарий = "Заказ №" + Строка(НомерЗаказа);

	Если ЗначениеЗаполнено(Организация.ОсновнойБанковскийСчет) Тогда
		Счет.СтруктурнаяЕдиница = Организация.ОсновнойБанковскийСчет;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьСтрокуСчетаПоУмолчанию(
	СтрокаСчета,
	Номенклатура,
	Количество,
	ДатаДокумента,
	ТипЦен
)
	СтрокаСчета.Номенклатура = Номенклатура;
	СтрокаСчета.Количество = Количество;
	
	ЦенаТовара = Ценообразование.ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦен, ДатаДокумента);
	
	// TODO: replace these defaults with the target configuration's price rules.
	СтрокаСчета.Цена = ЦенаТовара;
	СтрокаСчета.Сумма = ЦенаТовара * Количество;
	
	СтавкаНДСТовара = 10;
	//Если Номенклатура.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС. Тогда
	//	СтавкаНДСТовара = 10;
	//ИначеЕсли Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
	//	СтавкаНДСТовара = 18;
	//ИначеЕсли Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
	//	СтавкаНДСТовара = 20;
	//ИначеЕсли Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
	//	СтавкаНДСТовара = 22;
	//ИначеЕсли Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
	//	СтавкаНДСТовара = 5;
	//ИначеЕсли Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
	//	СтавкаНДСТовара = 7;
	//КонецЕсли;
	
	СтрокаСчета.СуммаНДС = Окр(СтрокаСчета.Сумма - (СтрокаСчета.Сумма * СтавкаНДСТовара / (100 + СтавкаНДСТовара)),2);

	// TODO: assign СтрокаСчета.СтавкаНДС according to the target configuration.
	// ДатаДокумента is intentionally accepted for this future calculation.
КонецПроцедуры

Процедура ЗаписатьСчет(Счет)
	// TODO: switch to РежимЗаписиДокумента.Проведение when all defaults are ready.
	Счет.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

