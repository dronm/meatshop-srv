////////////////////////////////////////////////////////////////////////////////
// Meatshop integration for goCOM1c; current backend command contract.
//
// Commands: complete_catalogue, create_order, create_shipments,
//           print_order, print_shipment.
// Legacy order_print_form is retained for callers using a single invoice UUID.
// Batch commands use numeric local order_ids; they do not accept 1C UUIDs.
//
// Required configuration changes (adapt document/attribute names in place):
// 1. Документ.СчетНаОплатуПокупателю:
//    - order_id: Number(15, 0), non-negative, indexed;
//    - order_version: Number(19, 0), non-negative;
//    - Товары.order_item_id: Number(15, 0), non-negative.
// 2. Документ.РеализацияТоваровУслуг:
//    - order_id: Number(15, 0), non-negative, indexed.
//    This scaffold models exactly one shipment per local order.
// 3. Add the independent, nonperiodic information register MeatshopOrderLocks:
//    - OrderID: a dimension of type Number(15, 0), non-negative;
//    - managed transaction locking mode.
//    Invoice updates and shipment creation use the same register key per order.
//    The register is only a logical lock space; no register records are written.
//    All integration writers must acquire this key before document lookup/write.
// 4. Implement organization/warehouse selection and invoice pricing/VAT defaults.
// 5. Adapt ПолучитьПроцентНДССтрокиСчета() and ПолучитьМаркировкуСтрокиСчета().
//    Their scaffold defaults are 0 and false; do not leave these for taxable or
//    marked goods. Response decimals use a dot, and amount always includes VAT.
// 6. Adapt shipment creation/header/line/save helpers in НастройкиОтгрузки.
// 7. Implement ПолучитьПечатнуюФормуОтгрузки(): return a ТабличныйДокумент
//    from the target configuration's print routine. It currently raises a TODO error.
//    Invoice printing reuses the original routine in ПолучитьПечатнуюФормуСчета().
// 8. Both save helpers currently write without posting. Adapt posting rules
//    after filling required attributes. Existing shipments are returned on retry;
//    later invoice edits do not automatically rebuild or repost them.
//
// create_order accepts nonnegative quantities and requires every order_item_id.
// Equal versions return saved results; older versions fail; newer versions update.
// Preserve order_id, order_version and line IDs in configuration write handlers.
// A shipment batch is atomic. Batch printing returns one combined PDF file path
// consumed by goCOM1c /bin-data, with documents in the requested order.
////////////////////////////////////////////////////////////////////////////////

Перем ОрганизацияИНН; 
Перем СкладНаименование;
Перем ТипыЦенНоменклатурыНаименование;

#Область РегистрацияВнешнейОбработки

Функция СведенияОВнешнейОбработке() Экспорт
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Myasmasters Web API");
	ПараметрыРегистрации.Вставить("Версия", "1.2");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Myasmasters Web API commands");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.0.7.6");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Meatshop Web API commands",
		"1",
		"ОткрытиеФормы",
		Истина,
		""
	);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(
	ТаблицаКоманд,
	Представление,
	Идентификатор,
	Использование,
	ПоказыватьОповещение = Ложь,
	Модификатор = ""
)
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

#КонецОбласти

#Область JSON

Процедура СформироватьДеревоJSON(ЧтениеJSON, Дерево)
	ИмяСвойства = Неопределено;

	Пока ЧтениеJSON.Прочитать() Цикл
		ТипJSON = ЧтениеJSON.ТипТекущегоЗначения;

		Если ТипJSON = ТипЗначенияJSON.НачалоОбъекта
			ИЛИ ТипJSON = ТипЗначенияJSON.НачалоМассива Тогда

			НовыйОбъект = ?(
				ТипJSON = ТипЗначенияJSON.НачалоОбъекта,
				Новый Соответствие,
				Новый Массив
			);

			Если ТипЗнч(Дерево) = Тип("Массив") Тогда
				Дерево.Добавить(НовыйОбъект);
			ИначеЕсли ТипЗнч(Дерево) = Тип("Соответствие")
				И ЗначениеЗаполнено(ИмяСвойства) Тогда
				Дерево.Вставить(ИмяСвойства, НовыйОбъект);
			КонецЕсли;

			СформироватьДеревоJSON(ЧтениеJSON, НовыйОбъект);

			Если Дерево = Неопределено Тогда
				Дерево = НовыйОбъект;
			КонецЕсли;

		ИначеЕсли ТипJSON = ТипЗначенияJSON.ИмяСвойства Тогда
			ИмяСвойства = ЧтениеJSON.ТекущееЗначение;

		ИначеЕсли ТипJSON = ТипЗначенияJSON.Число
			ИЛИ ТипJSON = ТипЗначенияJSON.Строка
			ИЛИ ТипJSON = ТипЗначенияJSON.Булево
			ИЛИ ТипJSON = ТипЗначенияJSON.Null Тогда

			Если ТипЗнч(Дерево) = Тип("Массив") Тогда
				Дерево.Добавить(ЧтениеJSON.ТекущееЗначение);
			ИначеЕсли ТипЗнч(Дерево) = Тип("Соответствие") Тогда
				Дерево.Вставить(ИмяСвойства, ЧтениеJSON.ТекущееЗначение);
			КонецЕсли;

		Иначе
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ParseJSON(СтрокаJSON)
	Если ТипЗнч(СтрокаJSON) <> Тип("Строка")
		ИЛИ ПустаяСтрока(СокрЛП(СтрокаJSON)) Тогда
		ВызватьИсключение("JSON parameters are required");
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = Неопределено;

	Попытка
		СформироватьДеревоJSON(ЧтениеJSON, Результат);
	Исключение
		ЧтениеJSON.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

Функция SerializeJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Возврат ЗаписьJSON.Закрыть();
КонецФункции

#КонецОбласти

#Область ПроверкаПараметров

Функция ПолучитьПараметрJSON(Параметры, ИмяПараметра, Обязательный = Истина)
	ЗначениеПараметра = Неопределено;
	ПараметрНайден = Ложь;

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ПараметрНайден = Параметры.Свойство(ИмяПараметра, ЗначениеПараметра);
	ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ЗначениеПараметра = Параметры.Получить(ИмяПараметра);
		ПараметрНайден = ЗначениеПараметра <> Неопределено;
	Иначе
		ВызватьИсключение("Command parameters must be a JSON object");
	КонецЕсли;

	Если Обязательный И Не ПараметрНайден Тогда
		ВызватьИсключение("Required parameter is missing: " + ИмяПараметра);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Функция ПолучитьОбязательнуюСтроку(Параметры, ИмяПараметра)
	ЗначениеПараметра = ПолучитьПараметрJSON(Параметры, ИмяПараметра);
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Строка") Тогда
		ВызватьИсключение("Parameter must be a string: " + ИмяПараметра);
	КонецЕсли;

	ЗначениеПараметра = СокрЛП(ЗначениеПараметра);
	Если ПустаяСтрока(ЗначениеПараметра) Тогда
		ВызватьИсключение("Parameter must not be empty: " + ИмяПараметра);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Функция ПолучитьПоложительноеЦелое(Параметры, ИмяПараметра)
	ЗначениеПараметра = ПолучитьПараметрJSON(Параметры, ИмяПараметра);
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Число")
		ИЛИ ЗначениеПараметра <= 0
		ИЛИ Цел(ЗначениеПараметра) <> ЗначениеПараметра Тогда
		ВызватьИсключение("Parameter must be a positive integer: " + ИмяПараметра);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Функция ПолучитьПоложительноеЧисло(Параметры, ИмяПараметра)
	ЗначениеПараметра = ПолучитьПараметрJSON(Параметры, ИмяПараметра);
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Число")
		ИЛИ ЗначениеПараметра <= 0 Тогда
		ВызватьИсключение("Parameter must be a positive number: " + ИмяПараметра);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Функция ПолучитьОбязательныйМассив(Параметры, ИмяПараметра)
	ЗначениеПараметра = ПолучитьПараметрJSON(Параметры, ИмяПараметра);
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Массив") Тогда
		ВызватьИсключение("Parameter must be an array: " + ИмяПараметра);
	КонецЕсли;

	Возврат ЗначениеПараметра;
КонецФункции

Функция ПолучитьУникальныйИдентификатор(Параметры, ИмяПараметра)
	СтрокаИдентификатора = ПолучитьОбязательнуюСтроку(Параметры, ИмяПараметра);

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СтрокаИдентификатора);
	Исключение
		ВызватьИсключение(
			"Parameter must contain a valid UUID: " + ИмяПараметра
		);
	КонецПопытки;

	Возврат Идентификатор;
КонецФункции

#КонецОбласти

#Область АвтодополнениеСправочников

Функция НайтиНоменклатуруПоНаименованию(Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА Номенклатура.Код = &Наименование ТОГДА 0
	|		КОГДА Номенклатура.Наименование ПОДОБНО &Префикс ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И (
	|		Номенклатура.Код = &Наименование
	|		ИЛИ Номенклатура.Наименование ПОДОБНО &Шаблон
	|	)
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Префикс", Наименование + "%");
	Запрос.УстановитьПараметр("Шаблон", "%" + Наименование + "%");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить(
			"id",
			СокрЛП(Строка(Выборка.Ссылка.УникальныйИдентификатор()))
		);
		Элемент.Вставить("name", СокрЛП(Выборка.Наименование));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция НайтиКонтрагентовПоНаименованию(Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.ИНН КАК ИНН,
	|	ВЫБОР
	|		КОГДА Контрагенты.ИНН = &Наименование ТОГДА 0
	|		КОГДА Контрагенты.Наименование ПОДОБНО &Префикс ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И (
	|		Контрагенты.ИНН ПОДОБНО &Префикс
	|		ИЛИ Контрагенты.Наименование ПОДОБНО &Шаблон
	|	)
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Префикс", Наименование + "%");
	Запрос.УстановитьПараметр("Шаблон", "%" + Наименование + "%");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить(
			"id",
			СокрЛП(Строка(Выборка.Ссылка.УникальныйИдентификатор()))
		);
		Элемент.Вставить("name", СокрЛП(Выборка.Наименование));
		Элемент.Вставить("inn", СокрЛП(Выборка.ИНН));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Command: complete_catalogue.
// Arguments:
//   СтрокаПараметров - a JSON string containing the params object below.
//   Ответ - the mutable response structure; this handler fills Ответ.payload.
// Required JSON fields:
//   catalogue_type - String: "Номенклатура" or "Контрагенты".
//   name - String: nonempty search text; surrounding whitespace is trimmed.
// Example params:
// {
//	"catalogue_type": "Номенклатура",
//	"name": "мяс"
// }
// Payload: an array of {id, name}; counterparties also include inn.
Процедура ВыполнитьАвтодополнениеСправочника(СтрокаПараметров, Ответ)
	Параметры = ParseJSON(СтрокаПараметров);
	ТипСправочника = ПолучитьОбязательнуюСтроку(
		Параметры,
		"catalogue_type"
	);
	Наименование = ПолучитьОбязательнуюСтроку(Параметры, "name");

	Если ТипСправочника = "Номенклатура" Тогда
		Результат = НайтиНоменклатуруПоНаименованию(Наименование);
	ИначеЕсли ТипСправочника = "Контрагенты" Тогда
		Результат = НайтиКонтрагентовПоНаименованию(Наименование);
	Иначе
		ВызватьИсключение(
			"Unsupported catalogue_type: " + ТипСправочника
		);
	КонецЕсли;

	Ответ.Вставить("payload", Результат);
КонецПроцедуры

#КонецОбласти

#Область Ссылки1С

Функция ПолучитьКонтрагентаПоИдентификатору(Идентификатор)
	ПредполагаемаяСсылка = Справочники.Контрагенты.ПолучитьСсылку(
		Идентификатор
	);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", ПредполагаемаяСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("Customer was not found by UUID");
	КонецЕсли;
	Если Выборка.ЭтоГруппа Тогда
		ВызватьИсключение("A customer group cannot be assigned to an order");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Функция ПолучитьНоменклатуруПоИдентификатору(Идентификатор)
	ПредполагаемаяСсылка = Справочники.Номенклатура.ПолучитьСсылку(
		Идентификатор
	);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", ПредполагаемаяСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("Product was not found by UUID");
	КонецЕсли;
	Если Выборка.ЭтоГруппа Тогда
		ВызватьИсключение("A product group cannot be added to an order");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

#КонецОбласти

