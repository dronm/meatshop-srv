Функция ПолучитьПервыйАктивныйДоговор(Контрагент)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И НЕ Договоры.ПометкаУдаления
	|	И Договоры.ВидДоговора =
	|		ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|УПОРЯДОЧИТЬ ПО
	|	Договоры.Код,
	|	Договоры.Ссылка";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение(
			"No active contract was found for customer " + Строка(Контрагент)
		);
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Функция ПолучитьВалютуРубль()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Код = &Код
	|	И НЕ Валюты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", "643");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("RUB currency with code 643 was not found");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Процедура ЗаполнитьШапкуСчета(Счет, Контрагент, НомерЗаказа)
	Организация = ПолучитьОрганизациюДляЗаказа();
	Если Не ЗначениеЗаполнено(Организация) Или Организация.Пустая() Тогда
		ВызватьИсключение("The organization for the order is not configured");
	КонецЕсли;

	Склад = ПолучитьСкладДляЗаказа();
	Если Не ЗначениеЗаполнено(Склад) Или Склад.Пустая() Тогда
		ВызватьИсключение("The warehouse for the order is not configured");
	КонецЕсли;

	Счет.Дата = ТекущаяДата();
	Счет.Организация = Организация;
	Счет.ОрганизацияПолучатель = Организация;
	Счет.Склад = Склад;
	Счет.ВидОперации = Перечисления.ВидыОперацийСчетаПокупателю.ТоварыИУслуги;
	Счет.Контрагент = Контрагент;
	Счет.ДоговорКонтрагента = ПолучитьПервыйАктивныйДоговор(Контрагент);
	Счет.ВалютаДокумента = ПолучитьВалютуРубль();
	Счет.СуммаВключаетНДС = Истина;
	Счет.КратностьВзаиморасчетов = 1;
	Счет.КурсВзаиморасчетов = 1;
	Счет.Ответственный = Пользователи.ТекущийПользователь();
	Счет.Комментарий = "Meatshop order #" + Строка(НомерЗаказа);

	Если ЗначениеЗаполнено(Организация.ОсновнойБанковскийСчет) Тогда
		Счет.СтруктурнаяЕдиница = Организация.ОсновнойБанковскийСчет;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьСтрокуСчетаПоУмолчанию(
	СтрокаСчета,
	Номенклатура,
	Количество,
	ДатаДокумента
)
	СтрокаСчета.Номенклатура = Номенклатура;
	СтрокаСчета.Количество = Количество;

	// TODO: replace these defaults with the target configuration's price rules.
	СтрокаСчета.Цена = 0;
	СтрокаСчета.Сумма = 0;
	СтрокаСчета.СуммаНДС = 0;

	// TODO: assign СтрокаСчета.СтавкаНДС according to the target configuration.
	// ДатаДокумента is intentionally accepted for this future calculation.
КонецПроцедуры

Процедура ЗаписатьСчет(Счет)
	// TODO: switch to РежимЗаписиДокумента.Проведение when all defaults are ready.
	Счет.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

#КонецОбласти

#Область СозданиеЗаказа

Процедура ЗаблокироватьСчетПоOrderID(НомерЗаказа)
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"Документ.СчетНаОплатуПокупателю"
	);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("order_id", НомерЗаказа);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция НайтиСчетПоOrderID(НомерЗаказа)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.order_id = &order_id";
	Запрос.УстановитьПараметр("order_id", НомерЗаказа);

	Выборка = Запрос.Выполнить().Выбрать();
	СсылкаНаСчет = Неопределено;
	Если Выборка.Следующий() Тогда
		СсылкаНаСчет = Выборка.Ссылка;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение(
				"More than one invoice has order_id=" + Строка(НомерЗаказа)
			);
		КонецЕсли;
	КонецЕсли;

	Возврат СсылкаНаСчет;
КонецФункции

Функция ПодготовитьТоварыЗаказа(ТоварыJSON)
	Если ТоварыJSON.Количество() = 0 Тогда
		ВызватьИсключение("The order must contain at least one product");
	КонецЕсли;

	Результат = Новый Массив;
	НомерСтроки = 0;
	Для Каждого ТоварJSON Из ТоварыJSON Цикл
		НомерСтроки = НомерСтроки + 1;

		Если ТипЗнч(ТоварJSON) <> Тип("Структура")
			И ТипЗнч(ТоварJSON) <> Тип("Соответствие") Тогда
			ВызватьИсключение(
				"Product at index " + Строка(НомерСтроки) + " must be an object"
			);
		КонецЕсли;

		Идентификатор = ПолучитьУникальныйИдентификатор(ТоварJSON, "id");
		Номенклатура = ПолучитьНоменклатуруПоИдентификатору(Идентификатор);
		Количество = ПолучитьПоложительноеЧисло(ТоварJSON, "quant");

		Товар = Новый Структура;
		Товар.Вставить("Номенклатура", Номенклатура);
		Товар.Вставить("Количество", Количество);
		Результат.Добавить(Товар);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ДанныеСчета1С(СсылкаНаСчет)
	Результат = Новый Структура;
	Результат.Вставить(
		"id",
		СокрЛП(Строка(СсылкаНаСчет.УникальныйИдентификатор()))
	);
	Результат.Вставить("descr", СокрЛП(Строка(СсылкаНаСчет)));
	Результат.Вставить("number_1c", СокрЛП(Строка(СсылкаНаСчет.Номер)));

	Возврат Результат;
КонецФункции

Процедура ВыполнитьСозданиеЗаказа(СтрокаПараметров, Ответ)
	Параметры = ParseJSON(СтрокаПараметров);
	НомерЗаказа = ПолучитьПоложительноеЦелое(Параметры, "order_id");

	// order_version is part of the Go contract. It is validated but deliberately
	// not stored in this scaffold; order_id is the idempotency identity.
	ВерсияЗаказа = ПолучитьПоложительноеЦелое(Параметры, "order_version");

	ИдентификаторКонтрагента = ПолучитьУникальныйИдентификатор(
		Параметры,
		"customer_id"
	);
	Контрагент = ПолучитьКонтрагентаПоИдентификатору(
		ИдентификаторКонтрагента
	);
	ТоварыJSON = ПолучитьОбязательныйМассив(Параметры, "products");
	Товары = ПодготовитьТоварыЗаказа(ТоварыJSON);

	ТранзакцияНачата = Ложь;
	Попытка
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		ТранзакцияНачата = Истина;

		ЗаблокироватьСчетПоOrderID(НомерЗаказа);
		СсылкаНаСчет = НайтиСчетПоOrderID(НомерЗаказа);

		Если СсылкаНаСчет = Неопределено Тогда
			Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
		Иначе
			Счет = СсылкаНаСчет.ПолучитьОбъект();
			Если Счет.ПометкаУдаления Тогда
				Счет.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			Если Счет.Проведен Тогда
				Счет.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
		КонецЕсли;

		Счет.order_id = НомерЗаказа;
		Счет.Товары.Очистить();
		ЗаполнитьШапкуСчета(Счет, Контрагент, НомерЗаказа);

		СуммаДокумента = 0;
		Для Каждого Товар Из Товары Цикл
			СтрокаСчета = Счет.Товары.Добавить();
			ЗаполнитьСтрокуСчетаПоУмолчанию(
				СтрокаСчета,
				Товар.Номенклатура,
				Товар.Количество,
				Счет.Дата
			);
			СуммаДокумента = СуммаДокумента + СтрокаСчета.Сумма;
		КонецЦикла;

		Счет.СуммаДокумента = СуммаДокумента;
		ЗаписатьСчет(Счет);

		ПроверочнаяСсылка = НайтиСчетПоOrderID(НомерЗаказа);
		Если ПроверочнаяСсылка = Неопределено
			ИЛИ ПроверочнаяСсылка <> Счет.Ссылка Тогда
			ВызватьИсключение(
				"Failed to preserve unique order_id=" + Строка(НомерЗаказа)
			);
		КонецЕсли;

		ДанныеСчета = ДанныеСчета1С(Счет.Ссылка);
		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;
	Исключение
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Ответ.Вставить("payload", ДанныеСчета);
КонецПроцедуры

#КонецОбласти

#Область ПечатнаяФормаЗаказа

Функция ПолучитьСчетПоИдентификатору(Идентификатор)
	ПредполагаемаяСсылка = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(
		Идентификатор
	);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.Ссылка = &Ссылка
	|	И НЕ Счета.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", ПредполагаемаяСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("Invoice was not found by UUID");
	КонецЕсли;

	Возврат Выборка.Ссылка;
КонецФункции

Процедура ВыполнитьПечатьЗаказа(СтрокаПараметров, Ответ)
	// Here order_id is the 1C document UUID returned by create_order,
	// not the numeric Meatshop order_id requisite.
	Параметры = ParseJSON(СтрокаПараметров);
	ИдентификаторСчета = ПолучитьУникальныйИдентификатор(
		Параметры,
		"order_id"
	);
	СсылкаНаСчет = ПолучитьСчетПоИдентификатору(ИдентификаторСчета);

	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыПечати = Новый Структура;
	СведенияСчета = Документы.СчетНаОплатуПокупателю.ПолучитьТаблицуСведенийСчетаНаОплату(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаСчет)
		);
	ТабличныйДокумент = ПечатьТорговыхДокументов.ПечатьСчетаНаОплату(
		СведенияСчета,
		ОбъектыПечати,
		ПараметрыПечати
	);

	Если ТабличныйДокумент = Неопределено Тогда
		ВызватьИсключение("1C did not create an invoice print form");
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
	ТабличныйДокумент.Записать(
		ИмяВременногоФайла,
		ТипФайлаТабличногоДокумента.PDF
	);
	ФайлПечатнойФормы = Новый Файл(ИмяВременногоФайла);
	Если Не ФайлПечатнойФормы.Существует()
		ИЛИ ФайлПечатнойФормы.Размер() = 0 Тогда
		ВызватьИсключение("1C created an empty invoice print form");
	КонецЕсли;

	Ответ.Вставить("payload", ИмяВременногоФайла);
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеКоманд

Функция ExecuteCommand(Команда, Параметры) Экспорт
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("error", "");

	Попытка
		Если Команда = "complete_catalogue" Тогда
			ВыполнитьАвтодополнениеСправочника(Параметры, Ответ);
		ИначеЕсли Команда = "create_order" Тогда
			ВыполнитьСозданиеЗаказа(Параметры, Ответ);
		ИначеЕсли Команда = "order_print_form" Тогда
			ВыполнитьПечатьЗаказа(Параметры, Ответ);
		Иначе
			ВызватьИсключение("Command not found: " + Команда);
		КонецЕсли;
	Исключение
		Ответ.success = Ложь;
		Ответ.error = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"MeatshopIntegration1C",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Команда + ": " + Ответ.error
		);
	КонецПопытки;

	Возврат SerializeJSON(Ответ);
КонецФункции

#КонецОбласти
